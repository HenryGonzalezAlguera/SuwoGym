@model RutinaMiembroDetalleModel

<div class="row">

    <div class="col-12">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a asp-action="Rutinas_Lista"
                       asp-controller="Miembro">

                        Mis rutinas

                    </a>

                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">

                    Detalle de la rutina

                </li>

            </ol>

        </nav>


        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <h2 class="mb-1">
                    @Model.NombreRutina
                </h2>

                <p class="mb-0 text-secondary">
                    Información general de la rutina
                </p>

            </div>


            <a asp-action="Rutinas_Ejercicios"
               asp-controller="Miembro"
               asp-route-i="@Model.IdRutina"
               class="btn btn-primary">

                <i class="ti ti-barbell"></i>

                Ver ejercicios

            </a>

        </div>

    </div>

</div>


<div class="card">

    <div class="card-body p-4">

        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <h4 class="mb-1">
                    Información de la rutina
                </h4>

                <p class="mb-0 text-secondary">
                    Planificación definida por su entrenador
                </p>

            </div>


            @if (Model.Estado)
            {
                <span class="badge bg-success">
                    Activa
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    Inactiva
                </span>
            }

        </div>


        <div class="row">

            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Número de rutina
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.IdRutina"
                       readonly />

            </div>


            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Nivel
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.Nivel"
                       readonly />

            </div>


            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Fecha de creación
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.FechaCreacion.ToString("dd/MM/yyyy"))"
                       readonly />

            </div>


            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Cantidad de ejercicios
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.CantidadEjercicios"
                       readonly />

            </div>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Nombre de la rutina
            </label>

            <input type="text"
                   class="form-control"
                   value="@Model.NombreRutina"
                   readonly />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Indicaciones generales
            </label>

            <textarea class="form-control"
                      rows="7"
                      readonly>@(string.IsNullOrWhiteSpace(Model.Detalles)
                          ? "Sin indicaciones generales."
                          : Model.Detalles)</textarea>

        </div>

    </div>

</div>


<div class="card mt-4">

    <div class="card-body p-4">

        <div class="mb-4">

            <h4 class="mb-1">
                Entrenador responsable
            </h4>

            <p class="mb-0 text-secondary">
                Información de contacto de su entrenador
            </p>

        </div>


        <div class="row">

            <div class="col-md-4 mb-3">

                <label class="form-label">
                    Nombre
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.NombreEntrenador"
                       readonly />

            </div>


            <div class="col-md-4 mb-3">

                <label class="form-label">
                    Correo electrónico
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.CorreoEntrenador"
                       readonly />

            </div>


            <div class="col-md-4 mb-3">

                <label class="form-label">
                    Teléfono
                </label>

                <input type="text"
                       class="form-control"
                       value="@(string.IsNullOrWhiteSpace(Model.TelefonoEntrenador)
                                           ? "No registrado"
                                           : Model.TelefonoEntrenador)"
                       readonly />

            </div>

        </div>

    </div>

</div>


<div class="d-flex
    justify-content-center
    gap-2
    mt-4">

    <a asp-action="Rutinas_Lista"
       asp-controller="Miembro"
       class="btn btn-light">

        <i class="ti ti-arrow-left"></i>

        Volver a rutinas

    </a>


    <a asp-action="Rutinas_Ejercicios"
       asp-controller="Miembro"
       asp-route-i="@Model.IdRutina"
       class="btn btn-primary">

        <i class="ti ti-barbell"></i>

        Ver ejercicios

    </a>

</div>