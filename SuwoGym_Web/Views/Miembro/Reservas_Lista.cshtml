@model List<ReservaClaseMiembroListaModel>

<section class="suwo-member-view suwo-member-reservas-lista">
<div class="suwo-page-heading d-flex justify-content-between align-items-center mb-4">

    <div>

        <span class="suwo-member-eyebrow"><i class="ti ti-calendar-check" aria-hidden="true"></i> Tu espacio SUWÓ</span>
            <h2 class="mb-1">
            Mis reservas
        </h2>

        <p class="text-secondary mb-0">
            Historial de clases reservadas
        </p>

    </div>


    <a asp-action="Clases_Disponibles"
       asp-controller="Miembro"
       class="btn btn-primary">

        <i class="ti ti-calendar-plus"></i>
        Buscar clases

    </a>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-info"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle suwo-member-table">

                    <thead>

                        <tr>

                            <th>
                                Clase
                            </th>

                            <th>
                                Entrenador
                            </th>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Horario
                            </th>

                            <th>
                                Reserva
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-center">
                                Acción
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @item.NombreClase
                                    </strong>

                                    <div>

                                        <small class="text-secondary">

                                            Reserva #@item.IdReserva

                                        </small>

                                    </div>

                                </td>


                                <td>
                                    @item.NombreEntrenador
                                </td>


                                <td>

                                    @item.FechaHoraInicio.ToString("dd/MM/yyyy")

                                </td>


                                <td>

                                    @item.FechaHoraInicio.ToString("hh:mm tt")

                                    -

                                    @item.FechaHoraFin.ToString("hh:mm tt")

                                </td>


                                <td>

                                    @item.FechaReserva.ToString("dd/MM/yyyy")

                                    <div>

                                        <small class="text-secondary">

                                            @item.FechaReserva.ToString("hh:mm tt")

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    @if (item.EstadoReserva == "Reservada")
                                    {
                                        <span class="badge bg-success">
                                            Reservada
                                        </span>
                                    }
                                    else if (item.EstadoReserva == "En curso")
                                    {
                                        <span class="badge bg-warning">
                                            En curso
                                        </span>
                                    }
                                    else if (item.EstadoReserva == "Finalizada")
                                    {
                                        <span class="badge bg-dark">
                                            Finalizada
                                        </span>
                                    }
                                    else if (item.EstadoReserva == "Cancelada")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelada
                                        </span>
                                    }
                                    else if (item.EstadoReserva == "Clase inactiva")
                                    {
                                        <span class="badge bg-secondary">
                                            Clase inactiva
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.EstadoReserva
                                        </span>
                                    }

                                </td>


                                <td class="text-center">

                                    @if (item.PuedeCancelar)
                                    {
                                        <form asp-action="Reservas_Cancelar"
                                              asp-controller="Miembro"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="IdReserva"
                                                   value="@item.IdReserva" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    title="Cancelar reserva"
                                                    onclick="return confirm('¿Está seguro de cancelar esta reserva?');">

                                                <i class="ti ti-calendar-cancel"></i>
                                                Cancelar

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">

                                            No disponible

                                        </span>
                                    }

                                </td>

                            </tr>


                            @if (item.FechaCancelacion.HasValue)
                            {
                                <tr>

                                    <td colspan="7"
                                        class="bg-light">

                                        <small class="text-secondary">

                                            Reserva cancelada el

                                            @item.FechaCancelacion.Value.ToString(
                                                "dd/MM/yyyy hh:mm tt")

                                        </small>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5 suwo-member-empty">

                <i class="ti ti-calendar-question"
                   style="font-size: 48px;">
                </i>

                <h4 class="mt-3">
                    No tiene reservas
                </h4>

                <p class="text-secondary">

                    Consulte las clases disponibles y reserve
                    su primer cupo.

                </p>


                <a asp-action="Clases_Disponibles"
                   asp-controller="Miembro"
                   class="btn btn-primary">

                    <i class="ti ti-calendar-plus"></i>
                    Ver clases disponibles

                </a>

            </div>
        }

    </div>

</div>
</section>
