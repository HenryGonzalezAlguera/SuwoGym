@model MiembroPerfilModel

<div class="row">

    <div class="col-12">

        <div class="mb-4">

            <h2 class="mb-1">
                Mi perfil
            </h2>

            <p class="mb-0 text-secondary">
                Información personal, membresía y entrenador asignado
            </p>

        </div>

    </div>

</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}

<div class="row">

    <!-- INFORMACIÓN PERSONAL -->
    <div class="col-lg-6 mb-3">
        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex
                justify-content-between
                align-items-center
                mb-4">

                <div>

                    <h5 class="mb-1 fw-bold">
                        Información personal
                    </h5>
                </div>

        </div>


        <div class="row">

            <div class="col-md-6 mb-3">
                <!-- Nombre completo -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Nombre Completo</label>
                    <p class="bip">@Model.Nombre @Model.Apellido</p>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <!-- Identificacion -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Identificación</label>
                    <p class="bip">@Model.Identificacion</p>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <!-- Correo -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Correo Electrónico</label>
                    <p class="bip">@Model.CorreoElectronico</p>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <!-- Telefono -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Teléfono</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.Telefono)
                                            ? "No registrado"
                                            : Model.Telefono)
                    </p>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <!-- Fecha Nac -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Fecha de Nacimiento</label>
                    <p class="bip">
                        @(Model.FechaNac?.ToString("dd/MM/yyyy") ?? "No registrada")
                    </p>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <!-- Estado -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Estado</label><br/>
                    @if (Model.Estado)
                    {
                        <p class=" badge bg-success-subtle text-success-emphasis bip">
                            Activo
                        </p>
                    }
                    else
                    {
                        <p class="badge bg-danger-subtle text-danger-emphasis bip">
                            Inactivo
                        </p>
                    }
                </div>
            </div>

            <div class="col-md-12 mb-3">
                <!-- Dirección -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Dirección</label>
                    <p class="bip">
                        @(Model.Direccion ?? "No registrada")
                    </p>
                </div>
            </div>

        </div>


    </div>

        </div>
    </div>

    <!-- MEMBRESÍA -->
    <div class="col-lg-6 mb-3">
        
        <!-- MEMBRESÍA -->
        <div class="card mb-3">

    <div class="card-body p-4">

        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <h5 class="mb-1 fw-bold">
                    Mi membresía
                </h5>
            </div>

        </div>


        @if (Model.IdMembresia.HasValue)
        {
            <div class="row">

                <div class="col-md-6">
                    <!-- Nombre Plan -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Plan Seleccionado</label>
                        <p class="bip">@Model.NombrePlan</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- Precio -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Precio</label>
                        <p class="bip">
                            @(string.IsNullOrWhiteSpace(Model.PrecioPlan.ToString())
                                            ? "No registrado"
                                            : Model?.PrecioPlan.ToString())
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- Fecha Inicio -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Fecha de Inicio</label>
                        <p class="bip">@(Model.FechaInicio?.ToString("dd/MM/yyyy") ?? "No registrada")</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- Fecha Vencimiento -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Fecha de Vencimiento</label>
                        <p class="bip">@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</p>
                    </div>
                </div>

                <div class="col-md-6">
                <!-- Estado Membresía -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Estado de Membresía</label> <br />
                    @if (string.Equals(
                        Model.EstadoMembresia,
                        "Activa",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success-subtle text-success-emphasis">
                            Activa
                        </span>
                    }
                    else if (string.Equals(
                        Model.EstadoMembresia,
                        "Vencida",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-danger-subtle text-danger-emphasis">
                            Vencida
                        </span>
                    }
                    else if (string.Equals(
                        Model.EstadoMembresia,
                        "Cancelada",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">
                            Cancelada
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">
                            @Model.EstadoMembresia
                        </span>
                    }

                </div>
            </div>

            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0"
                 role="alert">

                No tiene una membresía asignada actualmente.

            </div>
        }

    </div>

</div>

        
        <!-- ENTRENADOR -->
        <div class="card mb-3">

    <div class="card-body p-4">

        <div class="mb-4">

            <h5 class="mb-1 fw-bold">
                Mi entrenador
            </h5>

            <p class="mb-0 text-secondary">
                Entrenador responsable de su seguimiento
            </p>

        </div>


        @if (Model.IdEntrenador.HasValue)
        {
            <div class="row">

                <div class="col-md-6">
                    <!-- Nombre -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Nombre del Entrenador</label>
                        <p class="bip">@Model.NombreEntrenador</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <!-- Correo -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Correo Electrónico</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.CorreoEntrenador)
                                                    ? "No registrado"
                                                    : Model.CorreoEntrenador)
                            </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <!-- Teléfono -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Teléfono</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.TelefonoEntrenador)
                                                    ? "No registrado"
                                                    : Model.TelefonoEntrenador)
                            </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <!-- Teléfono -->
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Fecha de Asignación</label>
                            <p class="bip">
                                @(Model.FechaAsignacionEntrenador.HasValue
                                                    ? Model.FechaAsignacionEntrenador.Value.ToString("dd/MM/yyyy")
                                                : "No registrada")
                            </p>
                    </div>
                </div>

            </div>
        }
        else
        {
            <div class="alert alert-info mb-0"
                 role="alert">

                Todavía no tiene un entrenador asignado.

            </div>
        }

    </div>

</div>

    </div>
</div>








