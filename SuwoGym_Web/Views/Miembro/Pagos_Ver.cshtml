@model PagoMiembroDetalleModel

<section class="suwo-member-view suwo-member-pagos-ver">
<div class="row">

    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Pagos_Lista" asp-controller="Miembro" 
            class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />


        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <h2 class="mb-1">
                    Pago #@Model.IdPago
                </h2>

                <p class="mb-0 text-secondary">
                    Información detallada del pago de la membresía
                </p>

            </div>

        </div>

    </div>

</div>


<div class="card suwo-member-detail">
    <div class="card-body p-4">

        <h5 class="mb-3 fw-bold">
            Cliente
        </h5>
        <div class="row">

            <div class="col-md-4 mb-2">
                <!-- Nombre completo -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Nombre Completo</label>
                    <p class="bip">@Model.NombreMiembro</p>
                </div>
            </div>

            <div class="col-md-4 mb-2">
                <!-- Identificacion -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Identificación</label>
                    <p class="bip">@Model.Identificacion</p>
                </div>
            </div>

            <div class="col-md-4 mb-2">
                <!-- Correo -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Correo Electrónico</label>
                    <p class="bip">@Model.CorreoElectronico</p>
                </div>
            </div>

            

        </div>

        <hr class="lineaGris" />


        <h5 class="mb-3 fw-bold">
            Membresía
        </h5>
        <div class="row">

            <div class="col-md-4 mb-2">
                <!-- Nombre Plan -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Plan Actual</label>
                    <p class="bip">@Model.NombrePlan</p>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <!-- Duración -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Duración</label>
                    <p class="bip">@Model.DuracionDias días</p>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <!-- Estado de Membresía -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Estado</label>
                    <p class="bip">@Model.EstadoMembresia</p>
                </div>
            </div>
        </div>


        <hr class="lineaGris" />


        <h5 class="mb-3 fw-bold">
            Pago
        </h5>
        <div class="row">

            <div class="col-md-4 mb-2">
                <!-- Método -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Método de pago</label>
                    <p class="bip">@Model.MetodoPago</p>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <!-- Emisión -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Fecha de Emisión</label>
                    <p class="bip">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <!-- Referencia -->
                <div class="bloque_info">
                    <label class="bloque_info_titulo">N° de Referencia</label>
                    <p class="bip">@(Model.NumeroReferencia ?? "No registrada")</p>
                </div>
            </div>

            <!-- Subtotal -->
            <div class="col-md-4 mb-2">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Subtotal</label>
                    <p class="bip">&#8353; @Model.Subtotal.ToString("N2")</p>
                </div>
            </div>

            <!-- Impuesto-->
            <div class="col-md-4 mb-2">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Impuesto</label>
                    <p class="bip">&#8353; @Model.Impuesto.ToString("N2")</p>
                </div>
            </div>

            <!-- Total-->
            <div class="col-md-4 mb-2">
                <div class="bloque_info suwo-member-total">
                    <label class="bloque_info_titulo">TOTAL</label>
                    <p class="bip fs-4">&#8353; @Model.Total.ToString("N2")</p>
                </div>
            </div>

        </div>


    </div>
</div>
</section>
