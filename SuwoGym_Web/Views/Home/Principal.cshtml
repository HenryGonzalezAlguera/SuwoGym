@{
    Layout = "_Layout";
    ViewData["Title"] = "Panel Principal - SuwoGym";
}

<div class="page-title">
    <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last mb-2">
            <h1>
                <span class="ti ti-home"></span> Bienvenido, @ViewBag.NombreUsuario
            </h1>
            <p class="text-subtitle text-muted">Panel principal de SUWÓ</p>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
            <div class="float-end">
                <a href="@Url.Action("Logout")" class="btn btn-danger btn-sm">
                    <span class="ti ti-logout"></span> Cerrar Sesión
                </a>
            </div>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        <!-- Información del usuario -->
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Información de Cuenta</h4>
                </div>
                <div class="card-body">
                    <p><strong>Rol:</strong> <span class="badge bg-info">@ViewBag.NombreRol</span></p>
                    <hr />
                    <small class="text-muted">Acceso desde hace poco</small>
                </div>
            </div>
        </div>

        @if (ViewBag.NombreRol == "Administrador")
        {
            <!-- Admin Panel -->
            <div class="col-md-8 mb-3">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <h4 class="card-title mb-0">Panel de Administrador</h4>
                    </div>
                    <div class="card-body">
                        <p>Tienes acceso a todas las funciones del sistema.</p>
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-users" style="font-size: 2rem; color: #0c63e4;"></span>
                                    <h6 class="mt-2">Gestionar Usuarios</h6>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-chart-bar" style="font-size: 2rem; color: #0c63e4;"></span>
                                    <h6 class="mt-2">Reportes</h6>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-settings" style="font-size: 2rem; color: #0c63e4;"></span>
                                    <h6 class="mt-2">Configuración</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (ViewBag.NombreRol == "Entrenador")
        {
            <!-- Trainer Panel -->
            <div class="col-md-8 mb-3">
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <h4 class="card-title mb-0">Panel de Entrenador</h4>
                    </div>
                    <div class="card-body">
                        <p>Puedes gestionar rutinas y entrenamientos de tus clientes.</p>
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-users" style="font-size: 2rem; color: #198754;"></span>
                                    <h6 class="mt-2">Mis Clientes</h6>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-dumbbell" style="font-size: 2rem; color: #198754;"></span>
                                    <h6 class="mt-2">Rutinas</h6>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-calendar" style="font-size: 2rem; color: #198754;"></span>
                                    <h6 class="mt-2">Horarios</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Member Panel -->
            <div class="col-md-8 mb-3">
                <div class="card border-info">
                    <div class="card-header bg-info text-white">
                        <h4 class="card-title mb-0">Panel de Miembro</h4>
                    </div>
                    <div class="card-body">
                        <p>Accede a tus rutinas, entrenamientos y progreso.</p>
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-dumbbell" style="font-size: 2rem; color: #0dcaf0;"></span>
                                    <h6 class="mt-2">Mis Rutinas</h6>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-chart-line" style="font-size: 2rem; color: #0dcaf0;"></span>
                                    <h6 class="mt-2">Mi Progreso</h6>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="p-3 rounded bg-light">
                                    <span class="ti ti-user-circle" style="font-size: 2rem; color: #0dcaf0;"></span>
                                    <h6 class="mt-2">Mi Entrenador</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
