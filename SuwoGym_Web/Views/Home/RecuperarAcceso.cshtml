@{
    Layout = "_LayoutExterno";
}

<h1 class="auth-title">RECUPERAR <span class="naranjaClaro">ACCESO</span></h1>
<p class="auth-subtitle mb-5">Ingresa tu correo electrónico y te enviaremos intrucciones para reestablecer tu contraseña.</p>

<form action="index.html">
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="email" class="form-control form-control-xl text-gray-400" placeholder="Correo Electrónico">
        <div class="form-control-icon">
            <i class="bi bi-envelope"></i>
        </div>
    </div>
    <button class="btn btn-primary btn-block btn-lg shadow-lg mt-3 fs-4 p-3">SOLICITAR ACCESO</button>
</form>
<div class="text-center mt-5 text-lg fs-4">
    <p class='text-gray-600'>
        ¿Ha recordado su contraseña? <a href="auth-login.html">
        Iniciar Sesión
    </a>
</p>
</div>
