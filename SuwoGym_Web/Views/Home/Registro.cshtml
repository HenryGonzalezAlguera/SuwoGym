@{
    Layout = "_LayoutExterno";
}

<h2 class="card-title mt-1 mb-1" style="color:#0c0c0c;"><b>CREA TU <span class="naranjaClaro">CUENTA</span> </b></h2>
<p class="mb-5 text-secondary"><span>
        Empieza tu transformación hoy
</span></p>


<form class="needs-validation mt-3 align-content-start text-start" novalidate
    asp-action="Registro" asp-controller="Home" method="post">
    
    <!-- Nombre -->
    <div class="mb-5 text-start">            
        <label for="email" class="form-label text-start">
            <span class="ti ti-user mt-3"></span> Nombre Completo
        </label>
        <input type="text" class="form-control" placeholder="John Doe" required autofocus>
    </div>

    <!-- Correo Electrónico -->
    <div class="mb-3 text-start">
        <label for="email" class="form-label text-start">
            <span class="ti ti-mail mt-3"></span> Correo Electrónico
        </label>
        <input type="email" class="form-control" placeholder="nombre@ejemplo.com" required autofocus>
    </div>

    <!-- Contraseña -->
    <div class="mb-3 text-start">
        <label for="password" class="form-label d-flex justify-content-between">
            <span><span class="ti ti-lock mt-3"></span> Contraseña</span>
        </label>
        <input type="password" class="form-control" placeholder="_abc123" required minlength="6">
    </div>
 
    <!-- Confirmar Contraseña -->
    <div class="mb-5 text-start">
        <label for="password" class="form-label d-flex justify-content-between">
            <span><span class="ti ti-lock mt-3"></span> Confirmar Contraseña</span>
        </label>
        <input type="password" class="form-control" placeholder="_abc123" required minlength="6">
    </div>

    <!-- Botón -->
    <div class=" text-center align-content-center mt-2 mb-3">
        <button class="btn btn-primary btn-block btn-md shadow-lg fs-6 pl-3"
                asp-action="Index" asp-controller="Home">
            REGISTRARSE
        </button>
    </div>
    
</form>

<div class="text-center mt-5 text-lg fs-6">
    <p class="text-secondary">
        ¿Ya tiene cuenta? <a asp-action="Index" asp-controller="Home" class="link-primary">
        Iniciar sesión
    </a>
</p>
</div>
