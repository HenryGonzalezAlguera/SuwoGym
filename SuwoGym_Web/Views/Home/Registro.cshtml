@{
    Layout = "_LayoutExterno";
}

<form asp-action="Registro" asp-controller="Home" method="post">
    
    <!-- Nombre -->
    <div class="mb-5 text-start">            
        <label for="email" class="form-label text-start">
            <span class="ti ti-user mt-3"></span> Nombre Completo
        </label>
        <input type="text" class="form-control" placeholder="nombre@ejemplo.com" required autofocus>
    </div>
   <!--  <div class="mb-5 text-start">            
        <label for="email" class="form-label text-start">
            <span class="ti ti-user mt-3"></span> Apellidos
        </label>
        <input type="text" class="form-control" placeholder="nombre@ejemplo.com" required autofocus>
    </div>
-->
    <!-- Correo Electrónico -->
    <div class="mb-5 text-start">
        <label for="email" class="form-label text-start">
            <span class="ti ti-mail mt-3"></span> Correo Electrónico
        </label>
        <input type="email" class="form-control" placeholder="nombre@ejemplo.com" required autofocus>
    </div>

    <!-- Contraseña -->
    <div class="mb-5  text-start">
        <label for="password" class="form-label d-flex justify-content-between">
            <span><span class="ti ti-lock mt-3"></span> Contraseña</span>
            <a asp-action="RecuperarAcceso" asp-controller="Home" class="small link-primary">¿Olvidó su contraseña?</a>
        </label>
        <input type="password" class="form-control" placeholder="Password" required minlength="6">
    </div>
 
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="text" class="form-control form-control-xl text-gray-400" placeholder="Correo Electrónico">
        <div class="form-control-icon">
            <i class="bi bi-envelope"></i>
        </div>
    </div>
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="password" class="form-control form-control-xl text-gray-400" placeholder="Contraseña">
        <div class="form-control-icon">
            <i class="bi bi-lock"></i>
        </div>
    </div>
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="password" class="form-control form-control-xl text-gray-400" placeholder="Confirmar Contraseña">
        <div class="form-control-icon">
            <i class="bi bi-lock"></i>
        </div>
    </div>
    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-lg mt-3 fs-5 pl-1">REGISTRARSE</button>
</form>
<div class="text-center mt-5 text-lg fs-6">
    <p class='text-gray-500'>
        ¿Ya tiene cuenta? <a asp-action="Index" asp-controller="Home" class="link-primary">
        Iniciar sesión
    </a>
</p>
</div>
