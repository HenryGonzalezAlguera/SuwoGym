@{
    Layout = "_LayoutExterno";
}

<h1 class="auth-title">CREA TU <span class="naranjaClaro">CUENTA</span></h1>
<p class="auth-subtitle mb-5">Empieza tu transformación hoy</p>

<form action="index.html">
    <div class="row">
        <div class="col-6">
            <div class="form-group position-relative has-icon-left mb-4">
                <input type="text" class="form-control form-control-xl text-gray-400" placeholder="Nombre">
                <div class="form-control-icon">
                    <i class="bi bi-person"></i>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="form-group position-relative has-icon-left mb-4">
                <input type="text" class="form-control form-control-xl text-gray-400" placeholder="Apellidos">
                <div class="form-control-icon">
                    <i class="bi bi-person"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="text" class="form-control form-control-xl text-gray-400" placeholder="Correo Electrónico">
        <div class="form-control-icon">
            <i class="bi bi-envelope"></i>
        </div>
    </div>
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="password" class="form-control form-control-xl text-gray-400" placeholder="Contraseña">
        <div class="form-control-icon">
            <i class="bi bi-lock"></i>
        </div>
    </div>
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="password" class="form-control form-control-xl text-gray-400" placeholder="Confirmar Contraseña">
        <div class="form-control-icon">
            <i class="bi bi-lock"></i>
        </div>
    </div>
    <button class="btn btn-primary btn-block btn-lg shadow-lg mt-3 fs-4 p-3">REGISTRARSE</button>
</form>
<div class="text-center mt-5 text-lg fs-4">
    <p class='text-gray-500'>
       ¿Ya tiene cuenta? <a href="auth-login.html">
        Iniciar sesión
    </a>
</p>
</div>
