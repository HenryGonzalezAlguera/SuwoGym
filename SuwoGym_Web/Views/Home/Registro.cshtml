@model UsuarioModel

@{
    Layout = "_LayoutExterno";
    ViewData["Title"] = "Registro - SuwoGym";
    var opciones = ViewBag.Membresias;
}

<h2 class="card-title mt-1 mb-1" style="color:#0c0c0c;"><b>CREA TU <span class="naranjaClaro">CUENTA</span> </b></h2>
<p class="mb-5 text-secondary"><span>
        Empieza tu transformación hoy
</span></p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @foreach (var modelState in ViewData.ModelState.Values)
        {
            @foreach (var error in modelState.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <p><i class="ti ti-alert-triangle"></i> @ViewBag.Mensaje</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Registro" asp-controller="Home" method="post" 
      class="mt-3 align-content-start text-start" id="RegistroUsuarioFrom">

    <!-- Nombre -->
    <div class="mb-3 text-start">            
        <label class="form-label text-start">
            <span class="ti ti-user mt-3"></span> Nombre
        </label>
        <input asp-for="nombre" class="form-control" placeholder="Tu nombre" required autofocus id="nombre">
    </div>

    <!-- Apellido -->
    <div class="mb-3 text-start">            
        <label class="form-label text-start">
            <span class="ti ti-user mt-3"></span> Apellido
        </label>
        <input asp-for="apellido" class="form-control" placeholder="Tu apellido" required id="apellido">
    </div>

    <!-- Correo Electrónico -->
    <div class="mb-3 text-start">
        <label class="form-label text-start">
            <span class="ti ti-mail mt-3"></span> Correo Electrónico
        </label>
        <input asp-for="correoElectronico" class="form-control" type="email" placeholder="nombre@ejemplo.com" required id="correoElectronico">
    </div>

    <!-- Identificación -->
    <div class="mb-3 text-start">
        <label class="form-label text-start">
            <span class="ti ti-id mt-3"></span> Identificación
        </label>
        <input asp-for="identificacion" class="form-control" placeholder="Tu número de cédula o identificación" required id="identificacion">
    </div>

    <!-- Contraseña -->
    <div class="mb-3 text-start">
        <label class="form-label d-flex justify-content-between">
            <span><span class="ti ti-lock mt-3"></span> Contraseña</span>
        </label>
        <input asp-for="contrasenna" class="form-control" type="password" placeholder="Mínimo 6 caracteres" required minlength="8" id="contrasenna">
    </div>

    <!-- Tipo de Plan Membresía -->
    <div class="mb-6 mt-5 text-start">
        <label class="form-label d-flex justify-content-start">
            Seleccione un tipo de membresía
        </label>
            
        
        <div class="card-input-container" id="planMembresia">

            @foreach (var opcion in opciones)
            {
                <label>
                    <input type="radio" class="card-input-element" id="planMembresia_@opcion.IdPlan" name="planMembresia"
                           value="@opcion.IdPlan" />
                    <div class="panel panel-default card-input">
                        <div class="panel-heading"><h5><b>@opcion.NombrePlan</b></h5></div>
                        <div class="panel-body">
                            @opcion.Descripcion<br />
                            Duración: @opcion.DuracionDias días <br />
                            Precio: <b>&#8353; @string.Format("{0:N0}", opcion.Precio)</b>
                        </div>
                    </div>
                </label>
            
            }
            <input type="text" asp-for="PlanMembresia" id="plan"
                   class="form-control white-on-white"
                   readonly />
       
        </div>

    </div>


    <!-- Botón -->
    <div class=" text-center align-content-center mt-2 mb-3">
        <button type="submit" class="btn btn-primary btn-block btn-md shadow-lg fs-6 pl-3">
            REGISTRARSE
        </button>
    </div>

</form>

<div class="text-center mt-5 text-lg fs-6">
    <p class="text-secondary">
        ¿Ya tiene cuenta? <a asp-action="Index" asp-controller="Home" class="link-primary">
        Iniciar sesión
    </a>
</p>
</div>

<script src="~/js/registrousuario.js" asp-append-version="true"></script>


