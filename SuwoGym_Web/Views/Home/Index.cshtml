@{
    Layout = "_LayoutExterno";
}

<h1 class="auth-title">INICIAR <span class="naranjaClaro">SESIÓN</span></h1>
<p class="auth-subtitle mb-5">Bienvenido de nuevo a <span class="naranjaClaro">SUWÓ</span></p>

<form action="index.html">
    <div class="form-group position-relative has-icon-left mb-4">
        <input type="text" class="form-control form-control-xl text-gray-400" placeholder="Correo Electrónico">
        <div class="form-control-icon">
            <i class="bi bi-envelope"></i>
        </div>
    </div>
    <div class="form-group position-relative has-icon-left mb-2">
        <input type="password" class="form-control form-control-xl text-gray-400" placeholder="Contraseña">
        <div class="form-control-icon">
            <i class="bi bi-lock"></i>
        </div>
    </div>
    <div class="text-end fs-5">
        <p><a class="align-self-end" href="auth-forgot-password.html"><i>¿Olvidó su contraseña?</i></a></p>
    </div>

    <button class="btn btn-primary btn-block btn-lg shadow-lg mt-3 fs-4 p-3">INICIAR SESIÓN</button>
</form>
<div class="text-center mt-5 text-lg fs-4">
    <p class="text-gray-500">
        ¿Aún no tiene una cuenta? <a href="auth-register.html">
        Registrarse
        </a>
    </p>
</div>