@{
    Layout = "_LayoutExterno";
}

<h2 class="card-title mt-1 mb-1" style="color:#0c0c0c;"><b>INICIAR <span class="naranjaClaro">SESIÓN</span> </b></h2>
<p class="mb-5 text-secondary"><span>
    Bienvenido de nuevo a SUWÓ
</span></p>


<form class="needs-validation mt-3 align-content-start text-start" novalidate
     asp-action="Index" asp-controller="Home" method="post"> 
    
    <!-- Correo Electrónico -->
    <div class ="mb-5">
        <label for="email" class="form-label text-start">
            <span class="ti ti-mail mt-3"></span> Correo Electrónico</label>
        <input type="email" class="form-control" placeholder="nombre@ejemplo.com" required autofocus>
    </div>

    <!-- Contraseña -->
    <div class="mb-5">
        <label for="password" class="form-label d-flex justify-content-between">
            <span><span class="ti ti-lock mt-3"></span> Contraseña</span>
            <a asp-action="RecuperarAcceso" asp-controller="Home" class="small link-primary">¿Olvidó su contraseña?</a>
        </label>
        <input type="password" class="form-control" placeholder="_abc123" required minlength="6">
    </div>

    <!-- Botón -->
    <div class=" text-center align-content-center mt-2 mb-3">
        <button class="btn btn-primary btn-block btn-md shadow-lg fs-6 pl-3"
        asp-action="Principal" asp-controller="Home">
            INICIAR SESIÓN
        </button> 
    </div>

</form>

<div class="text-center mt-5 text-lg fs-6">
    <p class="text-secondary">
        ¿Aún no tiene una cuenta? <a asp-action="Registro" asp-controller="Home" class="link-primary">
        Registrarse
        </a>
    </p>
</div>