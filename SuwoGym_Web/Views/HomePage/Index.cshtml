
@{
    ViewData["Title"] = "SUWO GYM - Tu Gimnasio y Box de Confianza";
    Layout = "_LayoutVacio";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" crossorigin="" href="~/css/homepage.css">
</head>

<body>
    <!-- ========== NAVBAR ========== -->
    <nav class="navbar">
        <a href="#inicio" class="navbar-brand">
            <i class="fas fa-dumbbell"></i>
            SUWO<span>GYM</span>
        </a>
        <div class="menu-toggle" onclick="toggleMenu()">
            <i class="fas fa-bars"></i>
        </div>
        <ul class="nav-links" id="navLinks">
            <li><a href="#info">Información</a></li>
            <li><a href="#metodologias">Metodologías</a></li>
            <li><a href="#membresias">Membresías</a></li>
            <li><a href="#horarios">Horarios</a></li>
        </ul>
    </nav>

    <!-- ========== HERO ========== -->
    <section class="hero" id="inicio">
        <div class="hero-content">
            <h1>SUWO GYM</h1>
            <p class="subtitle">Transforma tu cuerpo y mente con nuestras metodologías innovadoras</p>
            <div class="hero-buttons">
                <a href="#membresias" class="btn-primary">Empieza Ahora</a>
                <a href="#metodologias" class="btn-secondary">Conoce Más</a>
            </div>
        </div>
    </section>

    <!-- ========== INFO GENERAL ========== -->
    <section class="info-section" id="info">
        <div class="container">
            <h2 class="section-title">Información General</h2>
            <div class="info-grid">
                <div class="info-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h3>Ubicación</h3>
                    <p>@Model.InfoGeneral.Direccion</p>
                </div>
                <div class="info-card">
                    <i class="fas fa-clock"></i>
                    <h3>Horario de Atención</h3>
                    <p>@Model.InfoGeneral.HorarioAtencion</p>
                </div>
                <div class="info-card">
                    <i class="fas fa-phone"></i>
                    <h3>Contacto</h3>
                    <p>@Model.InfoGeneral.Telefono<br>@Model.InfoGeneral.Email</p>
                </div>
                <div class="info-card">
                    <i class="fas fa-users"></i>
                    <h3>Comunidad</h3>
                    <p>+500 miembros activos<br>¡Únete a la familia SUWO!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== METODOLOGÍAS ========== -->
    <section class="metodologias-section" id="metodologias">
        <div class="container">
            <h2 class="section-title">Metodologías de Entrenamiento</h2>
            <div class="metodologias-grid">
                @foreach (var metodologia in Model.Metodologias)
                {
                    <div class="metodologia-card">
                        <div class="metodologia-header" style="background: linear-gradient(135deg, @metodologia.Color 33, @metodologia.Color 11);">
                            <i class="@metodologia.Icono" style="color: @metodologia.Color;"></i>
                            <h3>@metodologia.Nombre</h3>
                        </div>
                        <div class="metodologia-body">
                            <p>@metodologia.Descripcion</p>
                            <ul>
                                @foreach (var beneficio in metodologia.Beneficios)
                                {
                                    <li>@beneficio</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========== MEMBRESÍAS ========== -->
    <section class="membresias-section" id="membresias">
        <div class="container">
            <h2 class="section-title">Nuestras Membresías</h2>
            <div class="membresias-grid">
                @foreach (var membresia in Model.Membresias)
                {
                    <div class="membresia-card @(membresia.EsPopular ? "popular" : "")">
                        <span class="duracion">@membresia.Tipo</span>
                        <div class="precio">
                            $@string.Format("{0:N0}", membresia.Precio)
                            <small>/@membresia.Duracion</small>
                        </div>
                        <p class="descripcion">@membresia.Descripcion</p>
                        <ul>
                            @foreach (var beneficio in membresia.Beneficios)
                            {
                                <li>@beneficio</li>
                            }
                        </ul>
                        <button class="btn-membresia @(membresia.EsPopular ? "primary" : "")">
                            Elegir Plan
                        </button>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========== HORARIOS ========== -->
    <section class="horarios-section" id="horarios">
        <div class="container">
            <h2 class="section-title">Cronograma Semanal</h2>
            <div class="horario-tabs">
                @foreach (var dia in Model.Horarios.Dias)
                {
                    <button class="horario-tab @(dia.DiaSemana == "lunes" ? "active" : "")"
                            onclick="showDay('@dia.DiaSemana')">
                        @dia.Dia
                    </button>
                }
            </div>

            @foreach (var dia in Model.Horarios.Dias)
            {
                <div class="horario-content @(dia.DiaSemana == "lunes" ? "active" : "")"
                     id="@dia.DiaSemana">
                    <div class="horario-table-wrapper">
                        <table class="horario-table">
                            <thead>
                                <tr>
                                    <th>Hora</th>
                                    <th>Actividad</th>
                                    <th>Instructor</th>
                                    <th>Nivel</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var clase in dia.Clases)
                                {
                                    <tr>
                                        <td>@clase.HoraInicio - @clase.HoraFin</td>
                                        <td>
                                            <span class="clase-tag" style="background: @clase.ColorTag;">
                                                @clase.Actividad
                                            </span>
                                        </td>
                                        <td>@clase.Instructor</td>
                                        <td>@clase.Nivel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <p>&copy; @DateTime.Now.Year SUWO GYM - Todos los derechos reservados</p>
            <p>
                <a href="#">Política de Privacidad</a> |
                <a href="#">Términos y Condiciones</a>
            </p>
            <div class="social-icons">
                <a href="#" target="_blank"><i class="fab fa-facebook"></i></a>
                <a href="#" target="_blank"><i class="fab fa-instagram"></i></a>
                <a href="#" target="_blank"><i class="fab fa-youtube"></i></a>
                <a href="#" target="_blank"><i class="fab fa-tiktok"></i></a>
                <a href="#" target="_blank"><i class="fab fa-whatsapp"></i></a>
            </div>
        </div>
    </footer>

    <!-- ========== BOTÓN FLOTANTE ========== -->
    <a href="#inicio" class="floating-btn" title="Volver arriba">
        <i class="fas fa-arrow-up"></i>
    </a>

    <!-- ========== SCRIPTS ========== -->
    <script>
            // Toggle menú móvil
            function toggleMenu() {
                const navLinks = document.getElementById('navLinks');
                navLinks.classList.toggle('open');
            }

            // Mostrar día del horario
            function showDay(dayId) {
                // Ocultar todos los contenidos
                const contents = document.querySelectorAll('.horario-content');
                contents.forEach(content => {
                    content.classList.remove('active');
                });

                // Mostrar el contenido seleccionado
                const selectedContent = document.getElementById(dayId);
                if (selectedContent) {
                    selectedContent.classList.add('active');
                }

                // Actualizar tabs activos
                const tabs = document.querySelectorAll('.horario-tab');
                tabs.forEach(tab => {
                    tab.classList.remove('active');
                    // Activar el tab correspondiente
                    if (tab.textContent.trim().toLowerCase() ===
                        document.querySelector(`#${dayId}`).parentElement
                        .querySelector('.section-title')?.textContent.trim().toLowerCase() ||
                        tab.getAttribute('onclick')?.includes(dayId)) {
                        tab.classList.add('active');
                    }
                });

                // Método alternativo: buscar por onclick
                tabs.forEach(tab => {
                    const onclickAttr = tab.getAttribute('onclick');
                    if (onclickAttr && onclickAttr.includes(dayId)) {
                        tab.classList.add('active');
                    }
                });
            }

            // Cerrar menú al hacer click en un enlace (móvil)
            document.querySelectorAll('.nav-links a').forEach(link => {
                link.addEventListener('click', () => {
                    document.getElementById('navLinks').classList.remove('open');
                });
            });

            // Cerrar menú al hacer scroll
            let scrollTimeout;
            window.addEventListener('scroll', () => {
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    document.getElementById('navLinks').classList.remove('open');
                }, 100);
            });

            // Smooth scroll para todos los enlaces internos
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        const navHeight = document.querySelector('.navbar').offsetHeight;
                        const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - navHeight;
                        window.scrollTo({
                            top: targetPosition,
                            behavior: 'smooth'
                        });
                    }
                });
            });
    </script>
</body>
</html>