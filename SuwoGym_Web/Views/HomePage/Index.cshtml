
@{
    ViewData["Title"] = "SUWO GYM - Tu Gimnasio y Box de Confianza";
    Layout = "_LayoutVacio";
}


@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" crossorigin="" href="~/css/homepage.css" asp-append-version="true">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" asp-append-version="true">
</head>

<body>
   
    <!-- ========== NAVBAR ========== -->
    <nav class="navbar">
        <div>
            <a href="#inicio" class=" navbar-brand">
                <img src="~/images/logoSuwo_icon.png"
                     alt="Logo SUWÓ"
                     width="32"
                     height="32" />
                <span class="logo-text ms-2">
                    <img src="~/images/logoSuwo_logotype.png"
                         alt="SUWÓ Gym"
                         height="24"
                         class="mt-1" />
                </span>
            </a>
        </div>
        <div>
       
            <a class="menu-toggle" onclick="toggleMenu()">
                <i class="fas fa-bars"></i>
            </a>
            
            <ul class="nav-links" id="navLinks">
                <li><a href="#metodologias">Metodologías</a></li>
                <li><a href="#membresias">Membresías</a></li>
                <li><a href="#horarios">Horarios</a></li>
                <li><a href="#info">Información</a></li>
                <li><a asp-action="Index" asp-controller="Home" 
                    class="btn-menu">
                        <small>Iniciar Sesión</small>
                    </a>
                </li>
            </ul>
        </div>
  
    </nav>

    <main>

    <!-- ========== HERO ========== -->
    <section class="hero" id="inicio">
        <div class="hero-content">
            <img src="~/images/logoSuwo_icon.png"
                     alt="Logo SUWÓ principal" /><br/>
            <img src="~/images/logoSuwo_logotype.png"
                    alt="SUWÓ Gym"
                     style="padding-bottom:1rem;" />
            <p class="subtitle">Transforma tu cuerpo y mente con nuestras metodologías innovadoras</p>
            <div class="hero-buttons">
                <a href="#membresias" class="btn-primary">Empieza Ahora</a>
                <a href="#metodologias" class="btn-secondary">Conoce Más</a>
            </div>
        </div>
    </section>


    <!-- ========== METODOLOGÍAS ========== -->
    <section class="metodologias-section" id="metodologias">
        <div class="container">
            <h2 class="section-title">Metodologías de Entrenamiento</h2>
            <div class="metodologias-grid">
                @foreach (var metodologia in Model.Metodologias)
                {
                    <div class="metodologia-card">
                        <div class="metodologia-header" style="background: linear-gradient(135deg, @metodologia.Color 33, @metodologia.Color 11);">
                            <i class="@metodologia.Icono" style="color: @metodologia.Color;"></i>
                            <h3>@metodologia.NombreClase</h3>
                        </div>
                        <div class="metodologia-body">
                            <p>@metodologia.Descripcion</p>
                            <ul>
                                <li>@metodologia.Beneficio1</li>
                                <li>@metodologia.Beneficio2</li>
                                <li>@metodologia.Beneficio3</li>
                                <li>@metodologia.Beneficio4</li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========== MEMBRESÍAS ========== -->
    <section class="membresias-section" id="membresias">
        <div class="container">
            <h2 class="section-title" style="margin-bottom:4rem;">Nuestras Membresías</h2>
            <div class="membresias-grid">
                @foreach (var membresia in Model.Membresias)
                {
                    <div class="membresia-card @(membresia.EsPopular ? "popular" : "")">
                        <span class="duracion">@membresia.NombrePlan</span>
                        <div class="precio">
                                &#8353; @string.Format("{0:N0}", membresia.Precio)
                            <small>/ @membresia.DuracionDias días</small>
                        </div>
                        <p class="descripcion">@membresia.Descripcion</p>
                        <ul>
                                <li>@membresia.Beneficio1</li>
                                <li>@membresia.Beneficio2</li>
                                <li>@membresia.Beneficio3</li>
                                <li>@membresia.Beneficio4</li>
                        </ul>
                    </div>
                }
            </div>
            <div style="text-align:center; margin-top:4rem;">
                    <a asp-action="Registro" asp-controller="Home" class="btn-primary" style=" font-size:20px;">¡Comienza Hoy Mismo!</a>
            </div>
        </div>
    </section>

    <!-- ========== HORARIOS ========== -->
    <section class="horarios-section" id="horarios">
        <div class="container">
            <h2 class="section-title">Próximas clases</h2>

                    @if(ViewBag.CronoVacio != null)
                    {
                        <div class="info-card">
                            <p>@ViewBag.CronoVacio</p>
                        </div>
                    }
                    
                <div style="text-align:center; margin-top:1rem; margin-bottom:2rem;">
                    <a asp-action="Index" asp-controller="Home" 
                    class="btn-secondary">
                        ¡Registrarme a una clase!</a>
                </div>
                
                <div class="horario-table-wrapper">

                    <table class="horario-table">
                        <thead>
                            <tr>
                                <th>Clase</th>
                                <th>Entrenador</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Cupos Disponibles</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clase in Model.Horarios)
                            {
                                <tr>
                                    <td>@clase.NombreClase</td>
                                    <td>@clase.NombreEntrenador</td>
                                    <td>@clase.FechaHoraInicio.ToString("dd-MM-yyyy")</td>
                                    <td>@clase.FechaHoraInicio.ToString("hh:mm tt") - @clase.FechaHoraFin.ToString("hh:mm tt")</td>
                                    <td>@clase.CuposDisponibles</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                


            @*<div class="horario-tabs">
                @foreach (var dia in Model.Horarios.Dias)
                {
                    <button class="horario-tab @(dia.DiaSemana == "lunes" ? "active" : "")"
                            onclick="showDay('@dia.DiaSemana')">
                        @dia.Dia
                    </button>
                }
            </div>
            @foreach (var dia in Model.Horarios.Dias)
            {
                <div class="horario-content @(dia.DiaSemana == "lunes" ? "active" : "")"
                     id="@dia.DiaSemana">
                    <div class="horario-table-wrapper">
                        <table class="horario-table">
                            <thead>
                                <tr>
                                    <th>Hora</th>
                                    <th>Actividad</th>
                                    <th>Instructor</th>
                                    <th>Nivel</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var clase in dia.Clases)
                                {
                                    <tr>
                                        <td>@clase.HoraInicio - @clase.HoraFin</td>
                                        <td>
                                            <span class="clase-tag" style="background: @clase.ColorTag;">
                                                @clase.Actividad
                                            </span>
                                        </td>
                                        <td>@clase.Instructor</td>
                                        <td>@clase.Nivel</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
*@
        </div>
    </section>

    <!-- ========== INFO GENERAL ========== -->
    <section class="info-section" id="info">
        <div class="container">
            <h2 class="section-title">Información General</h2>
            <div class="info-grid">
                <div class="info-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h3>Ubicación</h3>
                    <p>@Model.InfoGeneral.Direccion</p>
                </div>
                <div class="info-card">
                    <i class="fas fa-clock"></i>
                    <h3>Horario de Atención</h3>
                    <p>@Model.InfoGeneral.HorarioAtencion</p>
                </div>
                <div class="info-card">
                    <i class="fas fa-phone"></i>
                    <h3>Contacto</h3>
                    <p>@Model.InfoGeneral.Telefono<br>@Model.InfoGeneral.Email</p>
                </div>
             
            </div>
        </div>
    </section>

    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="social-icons">
                <a href="https://www.facebook.com/p/SUwo_stc-100077480113642/" target="_blank"><i class="fab fa-facebook"></i></a>
                <a href="mailto:suwo.fv@gmail.com" target="_blank"><i class="fas fa-envelope"></i></a>
                <a href="https://wa.me/50688281766" target="_blank"><i class="fab fa-whatsapp"></i></a>
                <a href="#" target="_blank"><i class="fab fa-youtube"></i></a>
                <a href="#" target="_blank"><i class="fab fa-tiktok"></i></a>
            </div>
            <p style="margin-top: 20px;">&copy; @DateTime.Now.Year Gimansio SUWÓ - Todos los derechos reservados</p>
            <p><small>Programación Avanzada en la Web | IIC2026 | Proyecto Final | Grupo 3</small></p>
        </div>
    </footer>

    <!-- ========== BOTÓN FLOTANTE ========== -->
    <a href="#inicio" class="floating-btn" title="Volver arriba">
        <i class="fas fa-arrow-up"></i>
    </a>

    <!-- ========== SCRIPTS ========== -->
    <script src="~/js/homepage.js" asp-append-version="true"></script>
</body>
</html>