@model UsuarioModel

@{
    var nombre =
        Context.Session.GetString("Nombre");

    var nombreRol =
        Context.Session.GetString("NombreRol");

    var rol = 
        Context.Session.GetInt32("IdRol");
}

<div class="page-title mb-4">

    <div class="row">

        <div class="col-12">

            <h1>
                <span class="ti ti-settings"></span>
                Configuración
            </h1>

            <p class="text-subtitle text-muted">
                Centro de control de datos personales
            </p>

        </div>

    </div>

</div>




@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}

<div class="row">

    <div class="col-lg-6 mx-auto">

        <!-- Cambio de contraseña -->
        <div class="card p-2 mb-3">
            <div class="card-body">

                <h5 class="card-title mb-1"><b>
                    <span class="ti ti-lock"></span>
                    Cambiar contraseña
                    </b>
                </h5>
                <p class="text-subtitle text-muted mb-4">
                    Actualiza la contraseña de acceso a tu cuenta.
                </p>

                @if (ViewBag.MensajeSeguridad != null)
                {
                    <div class="alert
                                alert-@ViewBag.ClaseMensajeSeguridad
                                text-center">

                        @ViewBag.MensajeSeguridad

                    </div>
                }

                <form id="SeguridadForm"
                      asp-action="CambiarContrasenna"
                      asp-controller="Usuario"
                      method="post">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">

                                <label asp-for="contrasenna"
                                       class="form-label">

                                    Contraseña nueva
                                </label>

                                <input asp-for="contrasenna"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password">

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-4">

                                <label asp-for="confirmarContrasenna"
                                       class="form-label">

                                    Confirmar contraseña
                                </label>

                                <input asp-for="confirmarContrasenna"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password">

                            </div>

                        </div>
                    </div>

                    <div class="form-group text-end">

                        <button type="submit"
                                class="btn btn-primary">
                            Cambiar Contraseña
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script src="~/js/configuracion.js"
        asp-append-version="true"></script>