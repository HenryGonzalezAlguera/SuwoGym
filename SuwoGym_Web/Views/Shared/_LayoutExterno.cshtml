<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <link href="~/images/logoSuwo_icon.png"
          rel="icon"
          type="image/x-icon">

    <title>@(ViewData["Title"] ?? "Acceder") | SUWÓ GYM</title>

    <link rel="manifest"
          href="~/images/site.webmanifest">

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/main.css"
          asp-append-version="true">

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/apexcharts.css"
          asp-append-version="true">

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/colores.css"
          asp-append-version="true">
    <link rel="stylesheet" href="~/css/suwo-polish.css" asp-append-version="true">

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true">
    </script>

    <!-- jQuery Validate -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"
            asp-append-version="true">
    </script>

</head>

<body class="suwo-auth">

    <main class="container suwo-auth-wrap d-flex
        align-items-center
        justify-content-center
        min-vh-100">

        <div class="card suwo-auth-card my-4">

            <div class="card-body p-5">

                <div class="text-center mb-3">

                    <a asp-action="Index"
                       asp-controller="HomePage"
                       class="mb-5 mt-5 d-inline-block">

                        <img src="~/images/logoSuwo.png"
                             alt="Logo SUWÓ"
                             width="70">

                    </a>

                    @RenderBody()

                </div>

            </div>

        <div class="suwo-auth-footer text-center mb-4">
                <small> <small>Proyecto Final | Grupo 3 | IIC2026 </small></small>
        </div>
        </div>

    </main>

    

    <!-- Después se cargan los scripts de cada vista -->
    @await RenderSectionAsync(
        "Scripts",
        required: false)

    <!-- Scripts de la plantilla -->
    <script src="~/js/main.js"
            type="module"
            asp-append-version="true">
    </script>

</body>

</html>