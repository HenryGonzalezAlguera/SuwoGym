@{
    var nombre = Context.Session.GetString("Nombre");
    var rol = Context.Session.GetString("Rol");
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <!-- Pestaña -->
    <link href="~/images/logoSuwo_icon.png"
          rel="icon"
          type="image/x-icon" />

    <title>Suwo Gym</title>

    <link rel="manifest"
          href="~/images/site.webmanifest" />

    <!-- Archivos principales -->
    <script type="module"
            crossorigin=""
            src="~/js/main.js"
            asp-append-version="true">
    </script>

    <!-- Estilos -->
    <link rel="stylesheet"
          crossorigin=""
          href="~/css/main.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/apexcharts.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/colores.css"
          asp-append-version="true" />

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true">
    </script>

    <!-- jQuery Validate -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"
            asp-append-version="true">
    </script>

</head>

<body>

    <div id="overlay"
         class="overlay">
    </div>


    <!-- TOPBAR -->

    <nav id="topbar"
         class="navbar bg-white border-bottom fixed-top topbar px-3">

        <!-- TOGGLE PARA COMPUTADORA -->

        <button id="toggleBtn"
                class="d-none d-lg-inline-flex btn btn-light btn-icon btn-sm">

            <i class="ti ti-layout-sidebar-left-expand"></i>

        </button>


        <!-- TOGGLE PARA MÓVIL -->

        <button id="mobileBtn"
                class="btn btn-light btn-icon btn-sm d-lg-none me-2">

            <i class="ti ti-layout-sidebar-left-expand"></i>

        </button>


        <!-- NAVEGACIÓN SUPERIOR -->

        <div>

            <ul class="list-unstyled d-flex align-items-center mb-0 gap-2">

                <li class="ms-3 dropdown">

                    <a href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <div style="
                            background-color: aliceblue;
                            border-radius: 16px;
                            padding: 2px 6px;
                            font-size: 20px;">

                            <i class="ti ti-user-circle"></i>

                            <i class="ti ti-chevron-down"></i>

                        </div>

                    </a>


                    <div class="dropdown-menu dropdown-menu-end p-0"
                         style="min-width: 200px;">

                        <div>

                            <div class="d-flex gap-3
                                align-items-center
                                border-dashed
                                border-bottom
                                px-3 py-3">

                                <div>

                                    <h4 class="mb-0 small">

                                        <b>
                                            @nombre
                                        </b>

                                    </h4>

                                    <p class="mb-0 small">
                                        @rol
                                    </p>

                                </div>

                            </div>


                            <div class="p-3
                                d-flex
                                flex-column
                                gap-1
                                small
                                lh-lg">

                                <a asp-action="Configuracion"
                                   asp-controller="Usuario">

                                    <i class="ti ti-settings"></i>

                                    <span>
                                        Configuración
                                    </span>

                                </a>


                                <a asp-action="Logout"
                                   asp-controller="Home">

                                    <i class="ti ti-door-exit"></i>

                                    <span>
                                        Cerrar Sesión
                                    </span>

                                </a>

                            </div>

                        </div>

                    </div>

                </li>

            </ul>

        </div>

    </nav>


    <!-- SIDEBAR -->

    <aside id="sidebar"
           class="sidebar">

        <!-- LOGO -->

        <div class="logo-area">

            <a asp-action="Principal"
               asp-controller="Home"
               class="d-inline-flex">

                <img src="~/images/logoSuwo_icon.png"
                     alt="Logo SUWÓ"
                     width="32"
                     height="32" />

                <span class="logo-text ms-2">

                    <img src="~/images/logoSuwo_logotype.png"
                         alt="SUWÓ Gym"
                         height="24"
                         class="mt-1" />

                </span>

            </a>

        </div>


        <!-- NAVEGACIÓN -->

        <ul class="nav flex-column mt-2">

            <!-- OPCIÓN DISPONIBLE PARA TODOS -->

            <li>

                <a class="nav-link"
                   asp-action="Principal"
                   asp-controller="Home">

                    <i class="ti ti-home"></i>

                    <span class="nav-text">
                        Principal
                    </span>

                </a>

            </li>
        </ul>

            @if (rol == "Administrador")
            {
                <!-- MENÚ DEL ADMINISTRADOR -->

                <li>
                    <a class="nav-link"
                       asp-action="Dashboard"
                       asp-controller="Admin">

                        <i class="ti ti-graph"></i>

                        <span class="nav-text">
                            Dashboard
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Empleados_Lista"
                       asp-controller="Admin">

                        <i class="ti ti-badges"></i>

                        <span class="nav-text">
                            Empleados
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Clientes_Lista"
                       asp-controller="Admin">

                        <i class="ti ti-user"></i>

                        <span class="nav-text">
                            Clientes
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Planes_Lista"
                       asp-controller="Admin">

                        <i class="ti ti-credit-card"></i>

                        <span class="nav-text">
                            Planes de Membresía
                        </span>

                    </a>

                </li>
                              
            <li>

                <a class="nav-link"
                   asp-action="Horarios_Lista"
                   asp-controller="Admin">

                    <i class="ti ti-calendar-event"></i>

                    <span class="nav-text">
                        Horarios
                    </span>

                </a>

            </li>
             

               
               
            }
            else if (rol == "Entrenador")
            {
                <!-- MENÚ DEL ENTRENADOR -->

                <li>

                    <a class="nav-link"
                       asp-action="Clientes_Lista"
                       asp-controller="Entrenador">

                        <i class="ti ti-user"></i>

                        <span class="nav-text">
                            Clientes
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Rutinas_Lista"
                       asp-controller="Entrenador">

                        <i class="ti ti-activity"></i>

                        <span class="nav-text">
                            Rutinas
                        </span>

                    </a>

                </li>
                <li>

                    <a class="nav-link"
                       asp-action="Ejercicios_Lista"
                       asp-controller="Entrenador">

                        <i class="ti ti-barbell"></i>

                        <span class="nav-text">
                            Ejercicios
                        </span>

                    </a>

                </li>
            <li>

                <a class="nav-link"
                   asp-action="Horarios_Lista"
                   asp-controller="Entrenador">

                    <i class="ti ti-calendar-event"></i>

                    <span class="nav-text">
                        Mi cronograma
                    </span>

                </a>

            </li>
            <li>

                <a class="nav-link"
                   asp-action="Asistencias_Lista"
                   asp-controller="Entrenador">

                    <i class="ti ti-clipboard-check"></i>

                    <span class="nav-text">
                        Asistencias
                    </span>

                </a>

            </li>
            }
            else if (rol == "Miembro")
            {
                <!-- MENÚ DEL MIEMBRO -->

                <li>

                    <a class="nav-link"
                       asp-action="Perfil"
                       asp-controller="Miembro">

                        <i class="ti ti-user-circle"></i>

                        <span class="nav-text">
                            Mi perfil
                        </span>

                    </a>

                </li>
                              

                <li>

                    <a class="nav-link"
                       asp-action="Pagos_Lista"
                       asp-controller="Miembro">

                        <i class="ti ti-receipt"></i>

                        <span class="nav-text">
                            Mis pagos
                        </span>

                    </a>

                </li>
            <li>

                <a class="nav-link"
                   asp-action="Clases_Disponibles"
                   asp-controller="Miembro">

                    <i class="ti ti-calendar-event"></i>

                    <span class="nav-text">
                        Clases disponibles
                    </span>

                </a>

            </li>


            <li>

                <a class="nav-link"
                   asp-action="Reservas_Lista"
                   asp-controller="Miembro">

                    <i class="ti ti-calendar-check"></i>

                    <span class="nav-text">
                        Mis reservas
                    </span>

                </a>

            </li>
            <li>

                <a class="nav-link"
                   asp-action="Historial_Asistencias"
                   asp-controller="Miembro">

                    <i class="ti ti-clipboard-check"></i>

                    <span class="nav-text">
                        Mi asistencia
                    </span>

                </a>

            </li>
            }

    </aside>


    <!-- CONTENIDO PRINCIPAL -->

    <main id="content"
          class="content py-10">

        <div class="container-fluid">

            <!-- Contenido de cada vista -->
            @RenderBody()


            <!-- FOOTER -->

            <div class="row">

                <footer class="py-2 mt-6 text-secondary">

                    <div class="row">

                        <div class="col-6">

                            <p class="mb-0">
                                Gimnasio SUWÓ | Fuerza, Enfoque y Balance
                            </p>

                        </div>


                        <div class="col-6 text-end">

                            <p class="mb-0">

                                Programación Avanzada en la Web | IIC2026 | Proyecto Final | Grupo 3

                            </p>

                        </div>

                    </div>

                </footer>

            </div>

        </div>

    </main>


    <!-- Bootstrap y scripts principales -->

    <script src="~/js/main.js"
            type="module"
            asp-append-version="true">
    </script>

</body>

</html>