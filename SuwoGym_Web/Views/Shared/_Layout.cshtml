@{
    var nombre = Context.Session.GetString("Nombre");
    var rol = Context.Session.GetString("Rol");
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <!-- Pestaña -->
    <link href="~/images/logoSuwo_icon.png"
          rel="icon"
          type="image/x-icon" />

    <title>@(ViewData["Title"] ?? "Panel principal") | SUWÓ GYM</title>

    <link rel="manifest"
          href="~/images/site.webmanifest" />

    <!-- Archivos principales -->
    <!-- Estilos principales. main.js se carga una sola vez al final del body. -->
    <!-- Estilos -->
    <link rel="stylesheet"
          crossorigin=""
          href="~/css/main.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/apexcharts.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          crossorigin=""
          href="~/css/colores.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/suwo-polish.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/suwo-member.css"
          asp-append-version="true" />

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true">
    </script>

    <!-- jQuery Validate -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"
            asp-append-version="true">
    </script>

</head>

<body class="suwo-app">

    <div id="overlay"
         class="overlay">
    </div>


    <!-- Barra superior -->
    <nav id="topbar"
         class="navbar bg-white border-bottom fixed-top topbar px-3"
         aria-label="Barra superior">
        <div class="suwo-topbar-left">
            <button id="toggleBtn" type="button"
                    class="d-none d-lg-inline-flex btn btn-light btn-icon btn-sm"
                    aria-label="Contraer o expandir menú lateral"
                    title="Contraer o expandir menú lateral">
                <i class="ti ti-layout-sidebar-left-expand" aria-hidden="true"></i>
            </button>
            <button id="mobileBtn" type="button"
                    class="btn btn-light btn-icon btn-sm d-lg-none"
                    aria-label="Abrir menú de navegación"
                    title="Abrir menú de navegación">
                <i class="ti ti-layout-sidebar-left-expand" aria-hidden="true"></i>
            </button>
            <div class="suwo-topbar-copy">
                <span class="suwo-topbar-eyebrow">Bienvenido a SUWÓ</span>
                <span class="suwo-topbar-title">Tu centro de entrenamiento</span>
            </div>
        </div>
        <div class="dropdown">
            <a href="#" role="button" class="suwo-user-toggle"
               data-bs-toggle="dropdown" aria-expanded="false"
               aria-label="Abrir menú de usuario">
                <span class="suwo-user-avatar" aria-hidden="true">
                    <i class="ti ti-user-circle"></i>
                </span>
                <span class="d-none d-sm-flex flex-column">
                    <span class="suwo-user-name">@nombre</span>
                    <span class="suwo-user-role">@rol</span>
                </span>
                <i class="ti ti-chevron-down" aria-hidden="true"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-end p-2" style="min-width: 210px;">
                <div class="px-2 py-2 border-bottom mb-2">
                    <div class="fw-bold small">@nombre</div>
                    <div class="text-secondary small">@rol</div>
                </div>
                <a class="d-block text-decoration-none mb-1"
                   asp-action="Configuracion" asp-controller="Usuario">
                    <i class="ti ti-settings me-2" aria-hidden="true"></i> Configuración
                </a>
                <a class="d-block text-decoration-none"
                   asp-action="Logout" asp-controller="Home">
                    <i class="ti ti-door-exit me-2" aria-hidden="true"></i> Cerrar sesión
                </a>
            </div>
        </div>
    </nav>


    <!-- SIDEBAR -->

    <aside id="sidebar"
           class="sidebar" aria-label="Menú principal">

        <!-- LOGO -->

        <div class="logo-area">

            <a asp-action="Principal"
               asp-controller="Home"
               class="d-inline-flex">

                <img src="~/images/logoSuwo_icon.png"
                     alt="Logo SUWÓ"
                     width="32"
                     height="32" />

                <span class="logo-text ms-2">

                    <img src="~/images/logoSuwo_logotype.png"
                         alt="SUWÓ Gym"
                         height="24"
                         class="mt-1" />

                </span>

            </a>

        </div>


        <!-- NAVEGACIÓN -->

        <ul class="nav flex-column suwo-nav-group">

            <!-- OPCIÓN DISPONIBLE PARA TODOS -->

            <li>

                <a class="nav-link"
                   asp-action="Principal"
                   asp-controller="Home">

                    <i class="ti ti-home"></i>

                    <span class="nav-text">
                        Principal
                    </span>

                </a>

            </li>

            <li class="suwo-nav-caption">Tu espacio</li>

            @if (rol == "Administrador")
            {
                <!-- MENÚ DEL ADMINISTRADOR -->

                <li>
                    <a class="nav-link"
                       asp-action="Dashboard"
                       asp-controller="Admin">

                        <i class="ti ti-graph"></i>

                        <span class="nav-text">
                            Dashboard
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Empleados_Lista"
                       asp-controller="Admin">

                        <i class="ti ti-badges"></i>

                        <span class="nav-text">
                            Empleados
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Clientes_Lista"
                       asp-controller="Admin">

                        <i class="ti ti-user"></i>

                        <span class="nav-text">
                            Clientes
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Planes_Lista"
                       asp-controller="Admin">

                        <i class="ti ti-credit-card"></i>

                        <span class="nav-text">
                            Planes de Membresía
                        </span>

                    </a>

                </li>
                              
            <li>
                <a class="nav-link"
                   asp-action="Clases_Lista"
                   asp-controller="Admin">
                    <i class="ti ti-barbell" aria-hidden="true"></i>
                    <span class="nav-text">Clases</span>
                </a>
            </li>
            <li>
                <a class="nav-link"
                   asp-action="Horarios_Lista"
                   asp-controller="Admin">

                    <i class="ti ti-calendar-event"></i>

                    <span class="nav-text">
                        Horarios
                    </span>

                </a>

            </li>
             

               
               
            }
            else if (rol == "Entrenador")
            {
                <!-- MENÚ DEL ENTRENADOR -->

                <li>

                    <a class="nav-link"
                       asp-action="Clientes_Lista"
                       asp-controller="Entrenador">

                        <i class="ti ti-user"></i>

                        <span class="nav-text">
                            Clientes
                        </span>

                    </a>

                </li>


                <li>

                    <a class="nav-link"
                       asp-action="Ejercicios_Lista"
                       asp-controller="Entrenador">

                        <i class="ti ti-barbell"></i>

                        <span class="nav-text">
                            Ejercicios
                        </span>

                    </a>

                </li>
                <li>

                    <a class="nav-link"
                       asp-action="Rutinas_Lista"
                       asp-controller="Entrenador">

                        <i class="ti ti-activity"></i>

                        <span class="nav-text">
                            Rutinas
                        </span>

                    </a>

                </li>
            <li>

                <a class="nav-link"
                   asp-action="Horarios_Lista"
                   asp-controller="Entrenador">

                    <i class="ti ti-calendar-event"></i>

                    <span class="nav-text">
                        Mi cronograma
                    </span>

                </a>

            </li>
            <li>

                <a class="nav-link"
                   asp-action="Asistencias_Lista"
                   asp-controller="Entrenador">

                    <i class="ti ti-clipboard-check"></i>

                    <span class="nav-text">
                        Asistencias
                    </span>

                </a>

            </li>
            }
            else if (rol == "Miembro")
            {
                <!-- MENÚ DEL MIEMBRO -->

                <li>

                    <a class="nav-link"
                       asp-action="Perfil"
                       asp-controller="Miembro">

                        <i class="ti ti-user-circle"></i>

                        <span class="nav-text">
                            Mi perfil
                        </span>

                    </a>

                </li>
                              

                <li>

                    <a class="nav-link"
                       asp-action="Pagos_Lista"
                       asp-controller="Miembro">

                        <i class="ti ti-receipt"></i>

                        <span class="nav-text">
                            Mis pagos
                        </span>

                    </a>

                </li>
            <li>

                <a class="nav-link"
                   asp-action="Clases_Disponibles"
                   asp-controller="Miembro">

                    <i class="ti ti-calendar-event"></i>

                    <span class="nav-text">
                        Clases disponibles
                    </span>

                </a>

            </li>


            <li>

                <a class="nav-link"
                   asp-action="Reservas_Lista"
                   asp-controller="Miembro">

                    <i class="ti ti-calendar-check"></i>

                    <span class="nav-text">
                        Mis reservas
                    </span>

                </a>

            </li>
            <li>

                <a class="nav-link"
                   asp-action="Historial_Asistencias"
                   asp-controller="Miembro">

                    <i class="ti ti-clipboard-check"></i>

                    <span class="nav-text">
                        Mi asistencia
                    </span>

                </a>

            </li>
            }

        </ul>
    </aside>


    <!-- CONTENIDO PRINCIPAL -->

    <main id="content"
          class="content py-10">

        <div class="container-fluid">

            <!-- Contenido de cada vista -->
            @RenderBody()


            <!-- Pie de página -->
            <footer class="suwo-footer">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p>&copy; @DateTime.Now.Year SUWÓ GYM · Fuerza, Enfoque y Balance</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p>Plataforma de gestión y entrenamiento</p>
                    </div>
                </div>
            </footer>

        </div>

    </main>


    <!-- Bootstrap y scripts principales -->

    <script src="~/js/main.js"
            type="module"
            asp-append-version="true">
    </script>
    <script src="~/js/suwo-polish.js"
            type="module"
            asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>