
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <!-- Pestaña -->
    <link href="~/images/logoSuwo_icon.png" rel="icon" type="image/x-icon">
    <title>@(ViewData["Title"] ?? "SUWÓ GYM") | SUWÓ GYM</title>
    
    <link rel="manifest" href="~/images/site.webmanifest">

    <!-- El bundle se carga una sola vez, al final del documento. -->
    <link rel="stylesheet" crossorigin="" href="~/css/main.css">
    <link rel="stylesheet" crossorigin="" href="~/css/apexcharts.css">
    <link rel="stylesheet" crossorigin="" href="~/css/colores.css">
    <link rel="stylesheet" href="~/css/suwo-polish.css" asp-append-version="true">

</head>

<body class="suwo-plain">

  <!-- MAIN CONTENT -->
  <main style="margin: 20px;">

      <!-- Page Content -->
      @RenderBody()

      <!-- Footer -->
      <div class="row">
        <footer class="py-2 mt-6 text-secondary">
            <div class="row">
              <div class="col-6">
                    <p class="mb-0">Gimnasio SUWÓ | Fuerza, Enfoque y Balance</p>
              </div>
              <div class="col-6 text-end">
                    <p class="mb-0">Plantilla InApp, Copyright @DateTime.Now.Year por <a href="https://codescandy.com/" target="_blank" class="text-primary">CodesCandy</a></p>
              </div>
            </div>
        </footer>
      </div>

</main>
  <!-- Bootstrap JS -->
  <script src="~/js/main.js" type="module" asp-append-version="true"></script>

</body>

</html>