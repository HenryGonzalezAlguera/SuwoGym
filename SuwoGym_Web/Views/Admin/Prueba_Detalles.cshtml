@model EmpleadoDetalle
<link href="~/css/ejemplo.css" rel="stylesheet" />


<!-- Header -->
<div class="row">
    <div class="col-12">
        <!-- Breadcrumb mejorado -->
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Empleados_Lista" asp-controller="Admin"
                           style="color: #007bff; text-decoration: none; transition: all 0.3s ease;"
                           onmouseover="this.style.color='#ff5500'; this.style.textDecoration='underline';"
                           onmouseout="this.style.color='#007bff'; this.style.textDecoration='none';">
                            <i class="fas fa-users me-1"></i> Empleados
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page" style="color: #293039; font-weight: 600;">
                        <i class="fas fa-user me-1"></i> Detalles del Empleado
                    </li>
                </ol>
            </nav>
        </div>
        <br />

        <!-- Titulo con acciones -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="color: #293039; font-weight: 700;">
                    <i class="fas fa-id-badge me-2" style="color: #007bff;"></i>
                    Detalles del Empleado
                </h2>
                <p class="mb-0" style="color: #6c757d;">
                    <i class="fas fa-clock me-1" style="color: #007bff;"></i>
                    Información completa del empleado
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Empleados_Lista" asp-controller="Admin" class="btn"
                   style="background-color: #f8f9fa; color: #293039; border: 2px solid #e0e0e0; border-radius: 10px; padding: 10px 24px; font-weight: 500; transition: all 0.3s ease;"
                   onmouseover="this.style.backgroundColor='#e9ecef'; this.style.borderColor='#007bff';"
                   onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e0e0e0';">
                    <i class="fas fa-arrow-left me-2"></i> Volver
                </a>
                <a asp-action="Empleados_Editar" asp-controller="Admin" class="btn"
                   style="background: linear-gradient(135deg, #007bff 0%, #0069d9 100%); color: white; border: none; border-radius: 10px; padding: 10px 24px; font-weight: 500; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(0,123,255,0.3);"
                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 25px rgba(0,123,255,0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,123,255,0.3)';">
                    <i class="fas fa-edit me-2"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Contenido de detalles -->
<div class="row">
    <div class="col-lg-4">
        <!-- Tarjeta de perfil -->
        <div class="card" style="border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
            <div class="card-body p-4 text-center">
                <!-- Avatar -->
                <div class="position-relative d-inline-block mb-3">
                    <div style="width: 120px; height: 120px; background: linear-gradient(135deg, #007bff 0%, #293039 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: 0 4px 20px rgba(0,123,255,0.3);">
                        <i class="fas fa-user" style="font-size: 50px; color: white;"></i>
                    </div>
                    <!-- Badge de estado -->
                    <div class="position-absolute" style="bottom: 0; right: 0;">
                        @if (Model.Estado)
                        {
                            <span class="badge" style="background-color: #28a745; color: white; padding: 8px 16px; border-radius: 20px; font-weight: 500; animation: pulse 2s infinite;">
                                <i class="fas fa-check-circle me-1"></i> Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background-color: #dc3545; color: white; padding: 8px 16px; border-radius: 20px; font-weight: 500;">
                                <i class="fas fa-times-circle me-1"></i> Inactivo
                            </span>
                        }
                    </div>
                </div>

                <h4 style="color: #293039; font-weight: 600;">@Model.Nombre @Model.Apellido</h4>
                <p style="color: #6c757d;">
                    <span class="badge" style="background-color: #e8f4fd; color: #007bff; padding: 6px 14px; border-radius: 20px; font-weight: 500;">
                        <i class="fas fa-user-tag me-1"></i> @Model.Rol
                    </span>
                </p>
                <p style="color: #6c757d; font-size: 0.9rem;">
                    <i class="fas fa-id-card me-1" style="color: #007bff;"></i>
                    ID: <strong style="color: #293039;">@Model.Identificacion</strong>
                </p>
                <hr style="border-color: #e0e0e0;">

                <!-- Información rápida -->
                <div class="row g-2">
                    <div class="col-6">
                        <div class="p-2" style="background-color: #f8f9fa; border-radius: 10px;">
                            <small style="color: #6c757d;">Correo</small>
                            <p style="color: #293039; font-weight: 500; margin: 0; font-size: 0.9rem;">
                                <i class="fas fa-envelope me-1" style="color: #007bff;"></i>
                                @Model.CorreoElectronico
                            </p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2" style="background-color: #f8f9fa; border-radius: 10px;">
                            <small style="color: #6c757d;">Teléfono</small>
                            <p style="color: #293039; font-weight: 500; margin: 0; font-size: 0.9rem;">
                                <i class="fas fa-phone me-1" style="color: #007bff;"></i>
                                @Model.Telefono
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta de acciones rápidas -->
        <div class="card mt-3" style="border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
            <div class="card-body p-3">
                <h6 style="color: #293039; font-weight: 600;" class="mb-3">
                    <i class="fas fa-bolt me-2" style="color: #ff5500;"></i>
                    Acciones Rápidas
                </h6>
                <div class="d-grid gap-2">
                    <button class="btn" style="background-color: #f8f9fa; color: #293039; border: 1px solid #e0e0e0; border-radius: 10px; padding: 8px 16px; transition: all 0.3s ease; text-align: left;"
                            onmouseover="this.style.backgroundColor='#e8f4fd'; this.style.borderColor='#007bff';"
                            onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e0e0e0';">
                        <i class="fas fa-envelope me-2" style="color: #007bff;"></i>
                        Enviar Correo
                        <i class="fas fa-arrow-right float-end" style="color: #007bff;"></i>
                    </button>
                    <button class="btn" style="background-color: #f8f9fa; color: #293039; border: 1px solid #e0e0e0; border-radius: 10px; padding: 8px 16px; transition: all 0.3s ease; text-align: left;"
                            onmouseover="this.style.backgroundColor='#e8f4fd'; this.style.borderColor='#007bff';"
                            onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e0e0e0';">
                        <i class="fas fa-phone me-2" style="color: #007bff;"></i>
                        Llamar
                        <i class="fas fa-arrow-right float-end" style="color: #007bff;"></i>
                    </button>
                    <button class="btn" style="background-color: #f8f9fa; color: #293039; border: 1px solid #e0e0e0; border-radius: 10px; padding: 8px 16px; transition: all 0.3s ease; text-align: left;"
                            onmouseover="this.style.backgroundColor='#e8f4fd'; this.style.borderColor='#007bff';"
                            onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e0e0e0';">
                        <i class="fas fa-calendar-alt me-2" style="color: #007bff;"></i>
                        Agendar Reunión
                        <i class="fas fa-arrow-right float-end" style="color: #007bff;"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Tarjeta de información detallada -->
        <div class="card" style="border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
            <div class="card-body p-4">
                <ul class="nav nav-tabs mb-4" id="infoTabs" role="tablist" style="border-bottom: 2px solid #e0e0e0;">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab"
                                style="color: #293039; font-weight: 500; border: none; border-bottom: 3px solid transparent; padding: 12px 20px; transition: all 0.3s ease;"
                                onmouseover="this.style.color='#007bff';"
                                onmouseout="this.style.color='#293039';">
                            <i class="fas fa-user me-2" style="color: #007bff;"></i>
                            Personal
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="laboral-tab" data-bs-toggle="tab" data-bs-target="#laboral" type="button" role="tab"
                                style="color: #293039; font-weight: 500; border: none; border-bottom: 3px solid transparent; padding: 12px 20px; transition: all 0.3s ease;"
                                onmouseover="this.style.color='#007bff';"
                                onmouseout="this.style.color='#293039';">
                            <i class="fas fa-briefcase me-2" style="color: #007bff;"></i>
                            Laboral
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="direccion-tab" data-bs-toggle="tab" data-bs-target="#direccion" type="button" role="tab"
                                style="color: #293039; font-weight: 500; border: none; border-bottom: 3px solid transparent; padding: 12px 20px; transition: all 0.3s ease;"
                                onmouseover="this.style.color='#007bff';"
                                onmouseout="this.style.color='#293039';">
                            <i class="fas fa-home me-2" style="color: #007bff;"></i>
                            Dirección
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Pestaña Personal -->
                    <div class="tab-pane fade show active" id="personal" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #007bff;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Nombre Completo</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">@Model.Nombre @Model.Apellido</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #007bff;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Identificación</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">@Model.Identificacion</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #007bff;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Fecha de Nacimiento</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-calendar-alt me-2" style="color: #007bff;"></i>
                                        @Model.FechaNac
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #007bff;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Edad</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-birthday-cake me-2" style="color: #ff5500;"></i>
                                        Edad años
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #007bff;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Correo Electrónico</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-envelope me-2" style="color: #007bff;"></i>
                                        @Model.CorreoElectronico
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #007bff;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Teléfono</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-phone me-2" style="color: #007bff;"></i>
                                        @Model.Telefono
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pestaña Laboral -->
                    <div class="tab-pane fade" id="laboral" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #ff5500;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Rol</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-user-tag me-2" style="color: #ff5500;"></i>
                                        @Model.Rol
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #ff5500;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Estado</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        @if (Model.Estado)
                                        {
                                            <span class="badge" style="background-color: #28a745; color: white; padding: 6px 14px; border-radius: 20px;">
                                                <i class="fas fa-check-circle me-1"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: #dc3545; color: white; padding: 6px 14px; border-radius: 20px;">
                                                <i class="fas fa-times-circle me-1"></i> Inactivo
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #ff5500;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Fecha de Ingreso</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-calendar-plus me-2" style="color: #ff5500;"></i>
                                        @Model.FechaRegistro.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #ff5500;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Antigüedad</label>
                                    <p style="color: #293039; font-weight: 600; margin: 0;">
                                        <i class="fas fa-clock me-2" style="color: #ff5500;"></i>
                                        Antiguedad 
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pestaña Dirección -->
                    <div class="tab-pane fade" id="direccion" role="tabpanel">
                        <div class="row">
                            <div class="col-12">
                                <div class="p-3" style="background-color: #f8f9fa; border-radius: 12px; border-left: 4px solid #293039;">
                                    <label style="color: #6c757d; font-size: 0.85rem; font-weight: 500;">Dirección de Vivienda</label>
                                    <p style="color: #293039; font-weight: 500; margin: 0; font-size: 1.05rem;">
                                        <i class="fas fa-map-pin me-2" style="color: #293039;"></i>
                                        @Model.Direccion
                                        </p>
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <div style="background-color: #f8f9fa; border-radius: 12px; padding: 20px; text-align: center;">
                                    <i class="fas fa-map-marked-alt" style="font-size: 48px; color: #007bff;"></i>
                                    <p style="color: #6c757d; margin-top: 10px;">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Ubicación en mapa (simulación)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estadísticas rápidas -->
        <div class="row mt-3">
            <div class="col-md-4">
                <div class="card" style="border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                    <div class="card-body p-3 text-center">
                        <i class="fas fa-calendar-check" style="font-size: 24px; color: #007bff;"></i>
                        <h6 style="color: #293039; margin: 5px 0 0;">Asistencias</h6>
                        <p style="color: #6c757d; font-size: 0.9rem;">95% este mes</p>
                        <div class="progress" style="height: 6px; border-radius: 10px;">
                            <div class="progress-bar" style="width: 95%; background-color: #007bff; border-radius: 10px;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                    <div class="card-body p-3 text-center">
                        <i class="fas fa-star" style="font-size: 24px; color: #ff5500;"></i>
                        <h6 style="color: #293039; margin: 5px 0 0;">Evaluación</h6>
                        <p style="color: #6c757d; font-size: 0.9rem;">4.5 / 5.0</p>
                        <div class="d-flex justify-content-center">
                            <i class="fas fa-star" style="color: #ff5500;"></i>
                            <i class="fas fa-star" style="color: #ff5500;"></i>
                            <i class="fas fa-star" style="color: #ff5500;"></i>
                            <i class="fas fa-star" style="color: #ff5500;"></i>
                            <i class="fas fa-star-half-alt" style="color: #ff5500;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                    <div class="card-body p-3 text-center">
                        <i class="fas fa-tasks" style="font-size: 24px; color: #293039;"></i>
                        <h6 style="color: #293039; margin: 5px 0 0;">Proyectos</h6>
                        <p style="color: #6c757d; font-size: 0.9rem;">5 en curso</p>
                        <span class="badge" style="background-color: #e8f4fd; color: #007bff; padding: 4px 12px;">Ver todos</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Bootstrap JS para tabs -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Script para interactividad adicional -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Animación de entrada para las tarjetas
        const cards = document.querySelectorAll('.card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'all 0.6s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, 100 * (index + 1));
        });

        // Efecto de hover en los botones de acción rápida
        const quickButtons = document.querySelectorAll('.d-grid .btn');
        quickButtons.forEach(btn => {
            btn.addEventListener('click', function(e) {
                const icon = this.querySelector('.fa-arrow-right');
                if (icon) {
                    icon.style.transition = 'transform 0.3s ease';
                    icon.style.transform = 'translateX(5px)';
                    setTimeout(() => {
                        icon.style.transform = 'translateX(0)';
                    }, 300);
                }

                // Simular acción
                const text = this.textContent.trim();
                alert(`📌 Acción: ${text}\n\nEsta es una simulación de la funcionalidad.`);
            });
        });

        // Animación de tabs
        const tabs = document.querySelectorAll('[data-bs-toggle="tab"]');
        tabs.forEach(tab => {
            tab.addEventListener('shown.bs.tab', function(e) {
                const targetId = this.getAttribute('data-bs-target');
                const target = document.querySelector(targetId);
                if (target) {
                    target.style.opacity = '0';
                    target.style.transform = 'translateX(20px)';
                    setTimeout(() => {
                        target.style.transition = 'all 0.4s ease';
                        target.style.opacity = '1';
                        target.style.transform = 'translateX(0)';
                    }, 100);
                }
            });
        });

        // Hover en pestañas
        tabs.forEach(tab => {
            tab.addEventListener('mouseenter', function() {
                if (!this.classList.contains('active')) {
                    this.style.color = '#007bff';
                    this.style.borderBottom = '3px solid #007bff';
                }
            });
            tab.addEventListener('mouseleave', function() {
                if (!this.classList.contains('active')) {
                    this.style.color = '#293039';
                    this.style.borderBottom = '3px solid transparent';
                }
            });
        });
    });
</script>

<!-- Animaciones CSS -->
