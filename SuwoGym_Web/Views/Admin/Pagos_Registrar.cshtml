@model PagoRegistrarModel

<div class="row">
    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Clientes_Ver" asp-controller="Admin" asp-route-i="@Model.IdUsuario"
            class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />

        <!-- Título -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h2>Registrar pago</h2>
            </div>
            <div>
                <a asp-action="Clientes_Pagos" asp-controller="Admin" class="btn btn-outline-primary" asp-route-i="@Model.IdUsuario">
                    <span> Historial de pagos</span>
                </a>
            </div>
        </div>

    </div>
</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">
    <div class="card-body p-4">

        <form asp-action="Pagos_Registrar"
              asp-controller="Admin"
              method="post"
              id="PagoRegistrarForm">

            <input asp-for="IdUsuario"
                   type="hidden" />

            <input asp-for="IdMembresia"
                   type="hidden" />

            <input asp-for="NombreCliente"
                   type="hidden" />

            <input asp-for="NombrePlan"
                   type="hidden" />

            <input asp-for="Subtotal"
                   type="hidden" />

            <input asp-for="Impuesto"
                   type="hidden" />

            <input asp-for="Total"
                   type="hidden" />


            <div class="row">

                <div class="col-md-6">
                   
                    <!-- Nombre completo -->
                    <div class="bloque_info mb-2">
                        <label class="bloque_info_titulo">Nombre</label>
                        <p class="bip">@Model.NombreCliente</p>
                    </div>
                   
                    <!-- Plan -->
                    <div class="bloque_info mb-2">
                        <label class="bloque_info_titulo">Plan de Membresía</label>
                        <p class="bip">@Model.NombrePlan</p>
                    </div>

                    <!-- Subtotal -->
                    <div class="bloque_info mb-2">
                        <label class="bloque_info_titulo">Subtotal</label>
                        <p class="bip">&#8353; @Model.Subtotal.ToString("N2")</p>
                    </div>
                  
                    <!-- Impuesto-->
                    <div class="bloque_info mb-2">
                        <label class="bloque_info_titulo">Impuesto</label>
                        <p class="bip">&#8353; @Model.Impuesto.ToString("N2")</p>
                    </div>
                  
                    <!-- Total-->
                    <div class="bloque_info mb-2">
                        <label class="bloque_info_titulo">TOTAL</label>
                        <p class="bip fs-4">&#8353; @Model.Total.ToString("N2")</p>
                    </div>

                </div>

                <div class="col-md-6">

                    <!-- Método de pago-->
                    <div class="form-group mb-5">

                        <label asp-for="MetodoPago"
                               class="form-label">

                            Método de pago

                        </label>

                        <select asp-for="MetodoPago"
                                asp-items="ViewBag.MetodosPago"
                                class="form-select"
                                id="MetodoPago"
                                required>

                            <option value="">
                                Seleccione un método
                            </option>

                        </select>

                    </div>

                    <!-- Número de referencia -->
                    <div class="form-group mb-5">

                        <label asp-for="NumeroReferencia"
                               class="form-label">

                            Número de referencia

                        </label>
                        <input asp-for="NumeroReferencia"
                               class="form-control mb-2"
                               maxlength="100"
                               id="NumeroReferencia" />

                        <small class="text-info">
                           <i class="ti ti-info-circle"></i> En efectivo se genera automáticamente.
                        </small>

                    </div>
                    
                    <!-- Botones -->
                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Clientes_Ver"
                            asp-controller="Admin"
                            asp-route-i="@Model.IdUsuario"
                            class="btn btn-light">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            Registrar pago

                        </button>

                    </div>

                </div>
            </div>

        </form>

    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const metodo =
            document.getElementById("MetodoPago");

        const referencia =
            document.getElementById("NumeroReferencia");

        function actualizarReferencia() {

            if (metodo.value === "Efectivo") {

                referencia.value = "";
                referencia.required = false;
                referencia.disabled = true;

            } else {

                referencia.disabled = false;
                referencia.required =
                    metodo.value !== "";
            }
        }

        metodo.addEventListener(
            "change",
            actualizarReferencia);

        actualizarReferencia();
    });
</script>