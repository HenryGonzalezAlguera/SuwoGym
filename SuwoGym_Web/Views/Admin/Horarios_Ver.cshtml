@model ClaseProgramadaDetalleModel
@{ ViewData["Title"] = "Detalle del horario"; }

<div class="row">

    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Horarios_Lista" asp-controller="Admin" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />


        <div class="d-flex justify-content-between align-items-center mb-4 suwo-admin-head">

            <div>

                <div class="suwo-admin-eyebrow"><i class="ti ti-calendar-event" aria-hidden="true"></i> Administración</div>
<h2 class="mb-1">
                    @Model.NombreClase
                </h2>

                <p class="text-secondary mb-0">
                    Clase programada #@Model.IdClaseProg
                </p>

            </div>
            <div>

                <a asp-action="Horarios_Editar"
                   asp-controller="Admin"
                   asp-route-i="@Model.IdClaseProg"
                   class="btn btn-outline-primary">

                    <i class="ti ti-pencil"></i>
                    Editar Clase

                </a>
            </div>

        </div>

    </div>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">
        @TempData["MensajeError"]
    </div>
}


<div class="row">
    
    <!-- Información general-->
    <div class="col-md-8">
        <div class="card mb-3">

    <div class="card-body p-4">

        <div class="mb-4">
            <h5 class="mb-1 fw-bold">
                Información de la clase
            </h5>
        </div>

        <div class="row">

            <!-- Nombre de clase -->
            <div class="col-md-6 mb-3">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Clase</label>
                    <p class="bip">@Model.NombreClase</p>
                </div>
            </div>
            
            <!-- Fecha -->
            <div class="col-md-6 mb-3">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Fecha</label>
                    <p class="bip">@Model.FechaHoraInicio.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
            
            <!-- Horario -->
            <div class="col-md-6 mb-3">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Horario</label>
                    <p class="bip">
                        @Model.FechaHoraInicio.ToString("hh:mm tt") - @Model.FechaHoraFin.ToString("hh:mm tt")
                    </p>
                </div>
            </div>

            <!-- Estado -->
            <div class="col-md-6 mb-3">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Estado</label> <br/>
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis">
                            Activa
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-danger-emphasis">
                            Inactiva
                        </span>
                    }

                </div>
            </div>
            
            <!-- Descripción -->
            <div class="col-md-12">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Descripción</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.DescripcionClase)
                           ? "Sin descripción."
                           : Model.DescripcionClase)
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>
    </div>

    <!-- Entrenador asignado -->
    <div class="col-md-4">
        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="mb-4">
                    <h5 class="mb-1 fw-bold">
                        Entrenador asignado
                    </h5>
                </div>

                <div class="row">
                   <!-- Nombre -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Nombre</label>
                            <p class="bip">@Model.NombreEntrenador</p>
                        </div>
                    </div>

                    <!-- Correo -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Correo Electrónico</label>
                            <p class="bip">@Model.CorreoEntrenador</p>
                        </div>
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Teléfono</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.TelefonoEntrenador)
                                                                   ? "No registrado"
                                                                   : Model.TelefonoEntrenador)
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Control de cupos -->
    <div class="col-md-12">
        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="mb-4">

                    <h5 class="mb-1 fw-bold">
                        Control de cupos
                    </h5>

                    <p class="text-secondary mb-0">
                        Capacidad actual de la clase
                    </p>

                </div>


                <div class="row">

                    <!-- Máximo -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Cupo máximo</label>
                            <p class="bip">@Model.CupoMaximo</p>
                        </div>
                    </div>

                    <!-- Actual -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Participantes Registrados</label>
                            <p class="bip">@Model.CupoActual</p>
                        </div>
                    </div>

                    <!-- Disponible -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Cupos Disponibles</label>
                            <p class="bip">@Model.CuposDisponibles</p>
                        </div>
                    </div>

                    <!-- Botón eliminar -->
                    <div class="col-md-3 text-end">
                        <form asp-action="Horarios_CambiarEstado"
                              asp-controller="Admin"
                              method="post">

                            <input type="hidden"
                                   name="IdClaseProg"
                                   value="@Model.IdClaseProg" />

                            <input type="hidden"
                                   name="Estado"
                                   value="@Model.Estado.ToString().ToLower()" />

                            @if (Model.Estado)
                            {
                                <button type="submit"
                                        class="btn btn-outline-danger">

                                    <i class="ti ti-circle-x"></i>
                                    Desactivar

                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-outline-success">

                                    <i class="ti ti-circle-check"></i>
                                    Activar

                                </button>
                            }

                        </form>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>


