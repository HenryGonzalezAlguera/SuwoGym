@model UsuarioModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Entorno

<!-- Header -->
<div class="row">
    <div class="col-12">
       
        <!-- Botón atrás -->
        <div>
            <a asp-action="Empleados_Lista" asp-controller="Admin" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />

        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h2>Editar Empleado</h2>
            </div>
            <div>
                <a asp-action="Empleados_Ver" asp-controller="Admin" class="btn btn-outline-primary" asp-route-i="@Model.IdUsuario">
                    <i class="ti ti-eye"></i><span> Ver Empleado</span>
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["MensajeError"] is string mensajeErrorAcceso)
{
    <div class="alert alert-danger" role="alert">@mensajeErrorAcceso</div>
}

<div class="row">
    
    <!-- Datos Generales -->
    <div class="col-lg-6 mb-4">
        <div class="card mb-4">
            <div class="card-body p-4">
                <form id="editarEmpleadoDPForm" asp-action="Empleados_EditarDatos" asp-controller="Admin" method="post">
                    <input type="hidden" asp-for="@Model.IdUsuario" />
                        
                    <h5 class="mb-4"><b>Datos personales</b></h5>
               
                    <!-- Nombre y apellido -->
                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <label for="nombre" class="form-label">
                                Nombre
                            </label>

                            <input asp-for="nombre"
                                    type="text"
                                    class="form-control"
                                    id="nombre"
                                    value="@Model.nombre"
                                    maxlength="80" />

                        </div>
                        <div class="col-md-6 mb-3">

                            <label for="apellido"
                                    class="form-label">
                                Apellido
                            </label>

                            <input asp-for="apellido"
                                    type="text"
                                    class="form-control"
                                    id="apellido"
                                    value="@Model.apellido"
                                    maxlength="80" />

                        </div>
                    </div>

                    <!-- Correo y teléfono -->
                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <label for="identificacion"
                                   class="form-label">
                                Identificación
                            </label>

                            <input asp-for="identificacion"
                                   type="text"
                                   class="form-control"
                                   id="identificacion"
                                   value="@Model.identificacion"
                                   maxlength="50" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label for="correo"
                                   class="form-label">
                                Correo electrónico
                            </label>

                            <input asp-for="correoElectronico"
                                   type="email"
                                   value="@Model.correoElectronico"
                                   class="form-control"
                                   id="correo"
                                   maxlength="150" />

                        </div>
                    </div>

                    <!-- Identificación y fecha de nacimiento -->
                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <label for="fechaNac"
                                    class="form-label">
                                Fecha de nacimiento
                            </label>

                            <input asp-for="fechaNac"
                                    type="date"
                                    class="form-control"
                                    id="fechaNac" />
                        </div>
                        <div class="col-md-6 mb-3">

                            <label for="telefon     o"
                                    class="form-label">
                                Teléfono
                            </label>

                            <input asp-for="telefono"
                                    type="text"
                                    value="@Model.telefono"
                                    class="form-control"
                                    id="telefono"
                                    maxlength="30" />

                        </div>
                    </div>

                    <!-- Dirección -->
                    <div class="mb-5">

                        <label for="direccion"
                                class="form-label">
                            Dirección de vivienda
                        </label>

                        <textarea asp-for="direccion"
                                    class="form-control"
                                    id="direccion"
                                    rows="4"
                                    maxlength="200">
                        </textarea>

                    </div>

                    <div class=" col-lg-12 align-content-center mb-3 text-end">
                        <button type="submit" class="btn btn-primary">Cambiar</button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- Datos Laborales -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                
                <h5 class="mb-4"><b>Datos laborales</b></h5>

                <!-- Editar Rol -->
                <form id="editarRolForm" asp-action="Empleados_EditarRol" asp-controller="Admin" method="post">
                    <input type="hidden" asp-for="@Model.IdUsuario" />
                    <input type="hidden" asp-for="@Model.Estado" />

                    <div class="row">
                        <div class="col-sm-3 align-content-center mb-1">
                            <p>Rol actual:  
                                <span class="badge bg-info-subtle text-info-emphasis">
                            <i class="ti ti-user"></i> @Model.NombreRol
                        </span></p>
                        </div>
                        <div class="col-sm-6 align-content-center mb-3">
                            <select asp-for=@Model.IdRol class="form-select" id="definirRol" asp-items="ViewBag.Roles">
                                <option value=""> --- Seleccione nuevo rol ---- </option>
                            </select>
                        </div>
                        <div class=" col-sm-3 align-content-center mb-3 text-end">
                            <button type="submit" class="btn btn-primary">Cambiar</button>
                        </div>
                    </div>
                </form>
                
                <hr class="lineaGris"/> <br /> 
                    
                <!-- Editar Estado -->
                <form id="editarEstadoForm" asp-action="Empleados_EditarEstado" asp-controller="Admin" method="post">
                    <input type="hidden" asp-for="@Model.IdUsuario" />
                    <input type="hidden" asp-for="@Model.IdRol" />
                    <input type="hidden" asp-for="@Model.Estado" />
                    
                    <div class="row">
                        <div class="col-sm-3 align-content-center mb-1">
                            @if (Model.Estado)
                            {
                                <p>
                                    Estado actual:
                                    <span class="badge bg-success-subtle text-success-emphasis">
                                        Activo
                                    </span>
                                </p>
                            }
                            else
                            {
                                <p>
                                    Estado actual:<span class="badge bg-danger-subtle text-danger-emphasis">
                                    Inactivo
                                </span>
                            </p>
                        }
                    </div>
                    <div class=" col-sm-9 align-content-center mb-3 text-end">
                        <button type="submit" class="btn btn-primary">Cambiar</button>
                    </div>
                    </div>
                </form>

                @if (Entorno.IsDevelopment() && Model.IdRol == 2 && Model.Estado)
                {
                    <hr class="my-4" />
                    <div class="d-flex align-items-start gap-3">
                        <span class="p-2 rounded-3" style="background:var(--suwo-orange-tint); color:var(--suwo-orange);">
                            <i class="ti ti-shield-lock fs-4" aria-hidden="true"></i>
                        </span>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-2">Recuperar acceso del entrenador</h6>
                            <p class="text-secondary small mb-3">
                                Si no recibió la contraseña por correo, genera una nueva clave temporal.
                                Se mostrará una sola vez y el entrenador deberá cambiarla al ingresar.
                                Disponible exclusivamente en el entorno local de desarrollo.
                            </p>
                            <form asp-controller="Admin"
                                  asp-action="Empleados_RestablecerAccesoTemporal"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idUsuario" value="@Model.IdUsuario" />
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="ti ti-key me-1" aria-hidden="true"></i>
                                    Generar contraseña temporal
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>


<script src="~/js/empleadoeditar.js"></script>




