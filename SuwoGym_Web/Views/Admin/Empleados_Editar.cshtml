
@model UsuarioModel

<!-- Header -->
<div class="row">
    <div class="col-12">
        <!-- Breadcrumb-->
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Empleados_Lista" asp-controller="Admin" class="link-primary">Empleados</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span>Editar Empleado</span>
                    </li>
                </ol>
            </nav>
        </div>
        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h4>Editar Empleado</h4>
            </div>
        </div>
    </div>
</div>



<div class="row">
    
    <!-- Datos Generales -->
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-body p-4">
                <div class="mt-2">
                    <h2 class="mb-2"><b>@Model.nombre @Model.apellido</b></h2>
                </div>
                <hr class="lineaGris"/>
                <div class="">
                    <small class="gris">Identificación</small>
                    <p>
                        <i class="ti ti-mail gris"></i>
                        <span>@Model.identificacion</span>
                    </p>
                </div>
                <div class="">
                    <small class="gris">Correo Electrónico</small>
                    <p>
                        <i class="ti ti-mail gris"></i>
                        <span>@Model.correoElectronico</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Modificación Datos -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">

                <!-- Editar Rol -->
                <form id="editarRolForm" asp-action="Empleados_EditarRol" asp-controller="Admin" method="post">
                    <input type="hidden" asp-for="@Model.IdUsuario" />
                    <input type="hidden" asp-for="@Model.Estado" />

                    <h5 class="mb-4"><b>Cambiar Rol</b></h5>
                    <div class="row">
                        <div class="col-sm-3 align-content-center mb-1">
                            <p>Rol actual:  
                                <span class="badge bg-info-subtle text-info-emphasis">
                            <i class="ti ti-user"></i> @Model.NombreRol
                        </span></p>
                        </div>
                        <div class="col-sm-6 align-content-center mb-3">
                            <select asp-for=@Model.IdRol class="form-select" id="definirRol" asp-items="ViewBag.Roles">
                                <option value=""> --- Seleccione nuevo rol ---- </option>
                            </select>
                        </div>
                        <div class=" col-sm-3 align-content-center mb-3 text-end">
                            <button type="submit" class="btn btn-primary">Cambiar</button>
                        </div>
                    </div>
                </form>
                
                <hr class="lineaGris"/> <br /> 
                    
                <!-- Editar Estado -->
                <form id="editarEstadoForm" asp-action="Empleados_EditarEstado" asp-controller="Admin" method="post">
                    <input type="hidden" asp-for="@Model.IdUsuario" />
                    <input type="hidden" asp-for="@Model.IdRol" />
                    <input type="hidden" asp-for="@Model.Estado" />
                    
                    <h5 class="mb-4"><b>Cambiar Estado</b></h5>
                    <div class="row">
                        <div class="col-sm-3 align-content-center mb-1">
                            @if (Model.Estado)
                            {
                                <p>
                                    Estado actual:
                                    <span class="badge bg-success-subtle text-success-emphasis">
                                        Activo
                                    </span>
                                </p>
                            }
                            else
                            {
                                <p>
                                    Estado actual:<span class="badge bg-danger-subtle text-danger-emphasis">
                                    Inactivo
                                </span>
                            </p>
                        }
                    </div>
                    <div class=" col-sm-9 align-content-center mb-3 text-end">
                        <button type="submit" class="btn btn-primary">Cambiar</button>
                    </div>
                    </div>
                </form>

            </div>
        </div>
    </div>

</div>





