@model List<ClaseProgramadaListaModel>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">
            Horarios y clases
        </h2>

        <p class="text-secondary mb-0">
            Administración de las clases programadas del gimnasio
        </p>
    </div>

    <a asp-action="Horarios_Agregar"
       asp-controller="Admin"
       class="btn btn-primary">

        <i class="ti ti-plus"></i>
        Programar clase

    </a>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-info"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Clase
                            </th>

                            <th>
                                Entrenador
                            </th>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Horario
                            </th>

                            <th>
                                Cupos
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @item.NombreClase
                                    </strong>

                                    <div>

                                        <small class="text-secondary">

                                            Clase #@item.IdClaseProg

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    <strong>
                                        @item.NombreEntrenador
                                    </strong>

                                    <div>

                                        <small class="text-secondary">

                                            @item.CorreoEntrenador

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    @item.FechaHoraInicio.ToString("dd/MM/yyyy")

                                </td>


                                <td>

                                    @item.FechaHoraInicio.ToString("hh:mm tt")

                                    -

                                    @item.FechaHoraFin.ToString("hh:mm tt")

                                </td>


                                <td>

                                    <strong>
                                        @item.CupoActual / @item.CupoMaximo
                                    </strong>

                                    <div>

                                        <small class="text-secondary">

                                            @item.CuposDisponibles disponibles

                                        </small>

                                    </div>

                                </td>


                                <td>

                                    @if (!item.Estado)
                                    {
                                        <span class="badge bg-secondary">
                                            Inactiva
                                        </span>
                                    }
                                    else if (item.FechaHoraFin < DateTime.Now)
                                    {
                                        <span class="badge bg-dark">
                                            Finalizada
                                        </span>
                                    }
                                    else if (item.FechaHoraInicio <= DateTime.Now
                                             && item.FechaHoraFin >= DateTime.Now)
                                    {
                                        <span class="badge bg-warning">
                                            En curso
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Programada
                                        </span>
                                    }

                                </td>


                                <td class="text-center">

                                    <a asp-action="Horarios_Ver"
                                       asp-controller="Admin"
                                       asp-route-i="@item.IdClaseProg"
                                       class="btn btn-sm btn-light"
                                       title="Ver detalle">

                                        <i class="ti ti-eye"></i>

                                    </a>


                                    <a asp-action="Horarios_Editar"
                                       asp-controller="Admin"
                                       asp-route-i="@item.IdClaseProg"
                                       class="btn btn-sm btn-primary"
                                       title="Editar">

                                        <i class="ti ti-edit"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="ti ti-calendar-off"
                   style="font-size: 48px;">
                </i>

                <h4 class="mt-3">
                    No hay clases programadas
                </h4>

                <p class="text-secondary">

                    Programe la primera clase para que aparezca
                    en esta sección.

                </p>

                <a asp-action="Horarios_Agregar"
                   asp-controller="Admin"
                   class="btn btn-primary">

                    <i class="ti ti-plus"></i>
                    Programar clase

                </a>

            </div>
        }

    </div>

</div>