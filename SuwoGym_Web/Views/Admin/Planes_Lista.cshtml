@model IEnumerable<PlanesMLista>

<div class="row">

    <div class="col-12">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <div>

                <h1>
                    Planes de membresía
                </h1>

                <p class="mb-0">
                    Administración de los planes disponibles en SUWÓ
                </p>

            </div>

        </div>

    </div>

</div>


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-warning"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card table-responsive p-2">

    @if (Model != null && Model.Any())
    {
        <table class="table mb-0
            text-nowrap
            table-hover">

            <thead class="border-light">

                <tr>

                    <th>
                        <b>Plan</b>
                    </th>

                    <th>
                        <b>Descripción</b>
                    </th>

                    <th>
                        <b>Duración</b>
                    </th>

                    <th>
                        <b>Precio</b>
                    </th>

                    <th class="text-center">
                        <b>Acciones</b>
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr class="align-middle">

                        <td>
                            @item.NombrePlan
                        </td>


                        <td>

                            @(string.IsNullOrWhiteSpace(item.Descripcion)
                                ? "Sin descripción"
                                : item.Descripcion)

                        </td>


                        <td>
                            @item.DuracionDias días
                        </td>


                        <td>
                            ₡@item.Precio.ToString("N2")
                        </td>


                        <td class="text-center align-middle">

                            <a asp-controller="Admin"
                               asp-action="Planes_Ver"
                               asp-route-i="@item.IdPlan"
                               class="btn btn-sm btn-light"
                               title="Ver plan">

                                <i class="ti ti-eye"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="text-center p-4">

            <p class="mb-0">
                No hay planes de membresía registrados.
            </p>

        </div>
    }

</div>