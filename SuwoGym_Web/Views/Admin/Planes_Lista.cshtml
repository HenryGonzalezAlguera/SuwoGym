@model IEnumerable<PlanesMLista>

<!-- Header -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h1>Planes de Membresía</h1>
                <p class="mb-0">Disponibles para los clientes del gimnasio SUWÓ </p>
            </div>
        </div>
    </div>
</div>


<div class="col-md-12">

    <!-- Lista de rutinas -->
    <div class="card table-responsive p-2">

        <table class="table mb-0 text-nowrap table-hover">
            <thead class="border-light">
                <tr>
                    <th><b>Nombre</b></th>
                    <th><b>Descripción</b></th>
                    <th><b>Duración (días)</b></th>
                    <th><b>Precio (&#8353;)</b></th>
                    <th><b>Acciones</b></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td>@item.NombrePlan</td>
                        <td>@item.Descripcion</td>
                        <td>@item.DuracionDias</td>
                        <td>@item.Precio</td>
                        <td class="">
                            <!-- <a href="#" class=""><i class="ti ti-edit ms-1"></i></a> -->
                            <a href="#" class=""><i class="ti ti-eye ms-1"></i></a>
                            <!-- <a href="#" class="link-danger"><i class="ti ti-trash ms-1"></i></a> -->
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>