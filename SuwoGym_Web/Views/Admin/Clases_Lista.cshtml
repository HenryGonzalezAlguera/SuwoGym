@model List<ClaseListaModel>
@{
    ViewData["Title"] = "Catálogo de clases";
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
    <div>
        <div class="text-uppercase fw-bold small mb-2" style="letter-spacing:.12em; color:var(--suwo-orange);">
            <i class="ti ti-barbell me-1" aria-hidden="true"></i> Administración
        </div>
        <h1 class="mb-1">Catálogo de clases</h1>
        <p class="text-secondary mb-0">Crea actividades para después asignarles entrenador, horario y cupos.</p>
    </div>
    <a asp-controller="Admin" asp-action="Clases_Agregar" class="btn btn-primary">
        <i class="ti ti-plus me-1" aria-hidden="true"></i> Nueva clase
    </a>
</div>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="status">@mensajeExito</div>
}
@if (ViewBag.MensajeError is string mensajeError)
{
    <div class="alert alert-danger" role="alert">@mensajeError</div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Actividades disponibles</h2>
                <span class="badge text-bg-light border">@Model.Count clases</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Clase</th>
                            <th scope="col">Descripción</th>
                            <th scope="col" class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var clase in Model)
                    {
                        <tr>
                            <td><strong>@clase.NombreClase</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(clase.Descripcion) ? "Sin descripción" : clase.Descripcion)</td>
                            <td class="text-end">
                                <a asp-controller="Admin" asp-action="Horarios_Agregar"
                                   class="btn btn-sm btn-light" title="Programar esta actividad">
                                    <i class="ti ti-calendar-plus me-1" aria-hidden="true"></i> Programar
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="suwo-empty-state text-center py-5">
                <i class="ti ti-calendar-off" aria-hidden="true"></i>
                <h2 class="h4 mt-3">Todavía no hay clases en el catálogo</h2>
                <p class="text-secondary">Registra tu primera actividad. Luego podrás programarla con un entrenador y un cupo.</p>
                <a asp-controller="Admin" asp-action="Clases_Agregar" class="btn btn-primary">
                    <i class="ti ti-plus me-1" aria-hidden="true"></i> Crear primera clase
                </a>
            </div>
        }
    </div>
</div>
