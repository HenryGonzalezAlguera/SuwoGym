@model PlanModel

<div class="row">
    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Planes_Lista" 
            asp-controller="Admin" 
            class="btn btn-light">
            <small><i class="ti ti-arrow-left"></i> 
                Volver</small></a>
        </div> <br />


        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h2>Detalles del plan</h2>
            </div>
            <div>
                <a asp-action="Planes_Modificar" 
                asp-controller="Admin" 
                asp-route-i="@Model.IdPlan"
                class="btn btn-outline-primary" >
                    <i class="ti ti-edit"></i><span>
                        Editar Plan</span>
                </a>
            </div>
        </div>

    </div>
</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <div class="row g-3">

            <div class="col-md-4">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Nombre del plan</label>
                    <p class="bip">@Model.NombrePlan</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Duración</label>
                    <p class="bip">@Model.DuracionDias días</p>
                </div>
            </div>
           
            <div class="col-md-4">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Precio</label>
                    <p class="bip">&#8353; @Model.Precio.ToString("N2")</p>
                </div>
            </div>
            
            <hr class="lineaGris"/>

            <div class="col-md-12 mb-2">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Descripción</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.Descripcion)
                          ? "Sin descripción"
                          : Model.Descripcion)
                    </p>
                </div>
            </div>

            <hr class="lineaGris"/>

            <div class="col-md-6">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Beneficio 1</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.Beneficio1)
                          ? "No definido"
                          : Model.Beneficio1)
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Beneficio 2</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.Beneficio2)
                          ? "No definido"
                          : Model.Beneficio2)
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Beneficio 3</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.Beneficio3)
                          ? "No definido"
                          : Model.Beneficio3)
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="bloque_info">
                    <label class="bloque_info_titulo">Beneficio 4</label>
                    <p class="bip">
                        @(string.IsNullOrWhiteSpace(Model.Beneficio4)
                          ? "No definido"
                          : Model.Beneficio4)
                    </p>
                </div>
            </div>



        </div>

    </div>

</div>