@model PlanModel

<div class="row">
    <div class="col-12">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a asp-action="Planes_Lista"
                       asp-controller="Admin">

                        Planes de membresía

                    </a>

                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">

                    Detalle del plan

                </li>

            </ol>

        </nav>


        <div class="mb-4">

            <h2>Detalle del plan</h2>

            <p class="mb-0">
                Información registrada del plan de membresía
            </p>

        </div>

    </div>
</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Identificador
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.IdPlan"
                       readonly />

            </div>


            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Nombre del plan
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.NombrePlan"
                       readonly />

            </div>

        </div>


        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Duración
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.DuracionDias días"
                       readonly />

            </div>


            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Precio
                </label>

                <input type="text"
                       class="form-control"
                       value="₡@Model.Precio.ToString("N2")"
                       readonly />

            </div>

        </div>


        <div class="mb-4">

            <label class="form-label">
                Descripción
            </label>

            <textarea class="form-control"
                      rows="4"
                      readonly>@(string.IsNullOrWhiteSpace(Model.Descripcion)
                          ? "Sin descripción"
                          : Model.Descripcion)</textarea>

        </div>


        <div class="d-flex justify-content-center gap-2">

            <a asp-action="Planes_Lista"
               asp-controller="Admin"
               class="btn btn-light">

                Volver

            </a>


            <a asp-action="Planes_Modificar"
               asp-controller="Admin"
               asp-route-i="@Model.IdPlan"
               class="btn btn-primary">

                Modificar plan

            </a>

        </div>

    </div>

</div>