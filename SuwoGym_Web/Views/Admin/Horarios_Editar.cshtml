@model ClaseProgramadaEditarModel

<div class="row">

    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Horarios_Ver" 
            asp-controller="Admin" 
            asp-route-i="@Model.IdClaseProg"
            class="btn btn-light">
                <small><i class="ti ti-arrow-left"></i> 
                Volver</small></a>
        </div> <br />

        <!-- Titulo -->
        <div class="mb-4">
            <h2 class="mb-1">
                Editar clase programada
            </h2>
        </div>

    </div>

</div>

@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}



<div class="card">

    <div class="card-body p-4">

        <form asp-action="Horarios_Editar"
              asp-controller="Admin"
              method="post">

            <input type="hidden"
                   name="IdClaseProg"
                   value="@Model.IdClaseProg" />

            <input type="hidden"
                   name="Inicio"
                   value="@Model.FechaHoraInicio" />
            
            <input type="hidden"
                   name="Fin"
                   value="@Model.FechaHoraFin" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label for="IdClase"
                           class="form-label">

                        Clase

                    </label>

                    <select id="IdClase"
                            name="IdClase"
                            asp-items="ViewBag.Clases"
                            class="form-select"
                            required>

                        <option value="0">
                            Seleccione una clase
                        </option>

                    </select>

                    <span asp-validation-for="IdClase"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label for="IdEntrenador"
                           class="form-label">

                        Entrenador

                    </label>

                    <select id="IdEntrenador"
                            name="IdEntrenador"
                            asp-items="ViewBag.Entrenadores"
                            class="form-select"
                            required>

                        <option value="0">
                            Seleccione un entrenador
                        </option>

                    </select>

                    <span asp-validation-for="IdEntrenador"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label for="FechaHoraInicio"
                           class="form-label">

                        Fecha y hora de inicio

                    </label>

                    <input type="datetime-local"
                           id="FechaHoraInicio"
                           name="FechaHoraInicio"
                           value="@Model.FechaHoraInicio.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control"
                           required />

                    <span asp-validation-for="FechaHoraInicio"
                          class="text-danger">
                    </span>



                </div>


                <div class="col-md-6 mb-3">

                    <label for="FechaHoraFin"
                           class="form-label">

                        Fecha y hora de finalización

                    </label>

                    <input type="datetime-local"
                           id="FechaHoraFin"
                           name="FechaHoraFin"
                           value="@Model.FechaHoraFin.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control"
                           required />

                    <span asp-validation-for="FechaHoraFin"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label for="CupoMaximo"
                           class="form-label">

                        Cupo máximo

                    </label>

                    <input type="number"
                           id="CupoMaximo"
                           name="CupoMaximo"
                           value="@Model.CupoMaximo"
                           min="1"
                           class="form-control"
                           required />

                    <span asp-validation-for="CupoMaximo"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="alert alert-warning"
                 role="alert">

                <i class="ti ti-alert-triangle"></i>

                El cupo máximo no puede ser menor que la cantidad
                actual de participantes.

            </div>


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Horarios_Ver"
                   asp-controller="Admin"
                   asp-route-i="@Model.IdClaseProg"
                   class="btn btn-light">
                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">
                    Guardar 

                </button>

            </div>

        </form>

    </div>

</div>