@model ClaseProgramadaEditarModel

<div class="row">

    <div class="col-12">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a asp-action="Horarios_Lista"
                       asp-controller="Admin">

                        Horarios

                    </a>

                </li>

                <li class="breadcrumb-item">

                    <a asp-action="Horarios_Ver"
                       asp-controller="Admin"
                       asp-route-i="@Model.IdClaseProg">

                        Detalle

                    </a>

                </li>

                <li class="breadcrumb-item active">

                    Editar

                </li>

            </ol>

        </nav>


        <div class="mb-4">

            <h2 class="mb-1">
                Editar clase programada
            </h2>

            <p class="text-secondary mb-0">
                Modifique el entrenador, horario, clase o capacidad
            </p>

        </div>

    </div>

</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <form asp-action="Horarios_Editar"
              asp-controller="Admin"
              method="post">

            <input asp-for="IdClaseProg"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="IdClase"
                           class="form-label">

                        Clase

                    </label>

                    <select asp-for="IdClase"
                            asp-items="ViewBag.Clases"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione una clase
                        </option>

                    </select>

                    <span asp-validation-for="IdClase"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="IdEntrenador"
                           class="form-label">

                        Entrenador

                    </label>

                    <select asp-for="IdEntrenador"
                            asp-items="ViewBag.Entrenadores"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione un entrenador
                        </option>

                    </select>

                    <span asp-validation-for="IdEntrenador"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="FechaHoraInicio"
                           class="form-label">

                        Fecha y hora de inicio

                    </label>

                    <input asp-for="FechaHoraInicio"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control"
                           required />

                    <span asp-validation-for="FechaHoraInicio"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="FechaHoraFin"
                           class="form-label">

                        Fecha y hora de finalización

                    </label>

                    <input asp-for="FechaHoraFin"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control"
                           required />

                    <span asp-validation-for="FechaHoraFin"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="CupoMaximo"
                           class="form-label">

                        Cupo máximo

                    </label>

                    <input asp-for="CupoMaximo"
                           type="number"
                           min="1"
                           class="form-control"
                           required />

                    <span asp-validation-for="CupoMaximo"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="alert alert-warning">

                <i class="ti ti-alert-triangle"></i>

                El cupo máximo no puede ser menor que la cantidad
                actual de participantes.

            </div>


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Horarios_Ver"
                   asp-controller="Admin"
                   asp-route-i="@Model.IdClaseProg"
                   class="btn btn-light">

                    Cancelar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="ti ti-device-floppy"></i>
                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}