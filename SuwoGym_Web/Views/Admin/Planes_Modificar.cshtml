@model PlanModel
@{ ViewData["Title"] = "Modificar plan"; }

<div class="row">
    <div class="col-12">
<!-- Botón atrás -->
        <div>
            <a asp-action="Planes_Lista" 
            asp-controller="Admin" 
            class="btn btn-light">
            <small><i class="ti ti-arrow-left"></i> 
                Volver</small></a>
        </div> <br />


        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4 suwo-admin-head">
            <div class="">
                <div class="suwo-admin-eyebrow"><i class="ti ti-edit" aria-hidden="true"></i> Administración</div>
<h2>Modificar un plan</h2>
            </div>
            <div>
                <a asp-action="Planes_Ver" 
                asp-controller="Admin" 
                asp-route-i="@Model.IdPlan"
                class="btn btn-outline-primary" >
                    <i class="ti ti-eye"></i><span>
                        Ver Detalle del Plan</span>
                </a>
            </div>
        </div>

    </div>
</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger
        alert-dismissible fade show"
         role="alert">

        <strong>
            No se pudo actualizar el plan.
        </strong>

        <div>
            @ViewBag.MensajeError
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <form id="PlanModificarForm"
              asp-action="Planes_Modificar"
              asp-controller="Admin"
              method="post">

            <input asp-for="IdPlan"
                   type="hidden" />
         

            <div class="row">

              
                <div class="col-md-4 mb-3">

                    <label asp-for="NombrePlan"
                           class="form-label">

                        Nombre del plan

                    </label>

                    <input asp-for="NombrePlan"
                           class="form-control"
                           maxlength="100" />

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="DuracionDias"
                           class="form-label">

                        Duración en días

                    </label>

                    <input asp-for="DuracionDias"
                           type="number"
                           class="form-control"
                           min="1" />

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="Precio"
                           class="form-label">

                        Precio

                    </label>

                    <input asp-for="Precio"
                           type="number"
                           class="form-control"
                           min="0.01"
                           step="0.01" />

                </div>

                <div class="col-md-12 mb-4">

                    <label asp-for="Descripcion"
                           class="form-label">

                        Descripción

                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="1"
                              maxlength="300">
                    </textarea>

                </div>


                    <!-- Beneficio 1 -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Beneficio1"
                               class="form-label">
                            Beneficio 1
                        </label>

                    <input asp-for="Beneficio1"
                                value="@Model.Beneficio1"
                                class="form-control"
                                maxlength="50"/>
                    </div>
                    
                    <!-- Beneficio 2 -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Beneficio2"
                               class="form-label">
                            Beneficio 2
                        </label>

                    <input asp-for="Beneficio2"
                                value="@Model.Beneficio2"
                                class="form-control"
                                maxlength="50"/>
                    </div>
                   
                    <!-- Beneficio 3 -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Beneficio3"
                               class="form-label">
                            Beneficio 3
                        </label>

                    <input asp-for="Beneficio3"
                                value="@Model.Beneficio3"
                                class="form-control"
                                maxlength="50"/>
                    </div>
                   
                    <!-- Beneficio 4 -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Beneficio4"
                               class="form-label">
                            Beneficio 4
                        </label>

                    <input asp-for="Beneficio4"
                                value="@Model.Beneficio4"
                                class="form-control"
                                maxlength="50"/>
                    </div>

                
            </div>



            <div class="d-flex justify-content-center gap-2 mt-3">

                <a asp-action="Planes_Ver"
                   asp-controller="Admin"
                   asp-route-i="@Model.IdPlan"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>



<script src="~/js/planModificar.js"
        asp-append-version="true">
</script>
