@model PlanModel

<div class="row">
    <div class="col-12">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a asp-action="Planes_Lista"
                       asp-controller="Admin">

                        Planes de membresía

                    </a>

                </li>

                <li class="breadcrumb-item">

                    <a asp-action="Planes_Ver"
                       asp-controller="Admin"
                       asp-route-i="@Model.IdPlan">

                        Detalle

                    </a>

                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">

                    Modificar plan

                </li>

            </ol>

        </nav>


        <div class="mb-4">

            <h2>Modificar plan</h2>

            <p class="mb-0">
                Actualizar la información del plan de membresía
            </p>

        </div>

    </div>
</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger
        alert-dismissible fade show"
         role="alert">

        <strong>
            No se pudo actualizar el plan.
        </strong>

        <div>
            @ViewBag.MensajeError
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <form id="PlanModificarForm"
              asp-action="Planes_Modificar"
              asp-controller="Admin"
              method="post">

            <input asp-for="IdPlan"
                   type="hidden" />


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Identificador
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.IdPlan"
                           readonly />

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="NombrePlan"
                           class="form-label">

                        Nombre del plan

                    </label>

                    <input asp-for="NombrePlan"
                           class="form-control"
                           maxlength="100" />

                </div>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="DuracionDias"
                           class="form-label">

                        Duración en días

                    </label>

                    <input asp-for="DuracionDias"
                           type="number"
                           class="form-control"
                           min="1" />

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="Precio"
                           class="form-label">

                        Precio

                    </label>

                    <input asp-for="Precio"
                           type="number"
                           class="form-control"
                           min="0.01"
                           step="0.01" />

                </div>

            </div>


            <div class="mb-4">

                <label asp-for="Descripcion"
                       class="form-label">

                    Descripción

                </label>

                <textarea asp-for="Descripcion"
                          class="form-control"
                          rows="4"
                          maxlength="300">
                </textarea>

            </div>


            <div class="d-flex justify-content-center gap-2">

                <a asp-action="Planes_Ver"
                   asp-controller="Admin"
                   asp-route-i="@Model.IdPlan"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>



{
<script src="~/js/planModificar.js"
        asp-append-version="true">
</script>
}