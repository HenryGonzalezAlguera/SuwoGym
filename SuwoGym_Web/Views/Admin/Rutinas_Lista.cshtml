
<!-- Header --> 
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h1>Rutinas</h1>
                <p class="mb-0">Defina las distintas rutinas según la clase y el nivel de los asistentes</p>
            </div>
        </div>
    </div>
</div>


<!-- Contenido -->
<div class="row">
   
    <!-- Formulario Para agregar la rutina  ------------------------------------- -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">

                <form id="rutinaForm">

                    <div class="mb-3">
                        <label for="nombreRutina" class="form-label">Nombre de Rutina</label>
                        <input type="text" class="form-control" id="nombreRutina" placeholder="Nombre" required="">
                    </div>

                    <div class="mb-3">
                        <label for="nivelRutina" class="form-label">Nivel</label>
                        <select class="form-select" id="nivelRutina" required="">
                            <option value=""> --- Seleccione un nivel ---- </option>
                            <option value="Principiante">Principiante</option>
                            <option value="Intermedio">Intermedio</option>
                            <option value="Avanzado">Avanzado</option>
                        </select>
                    </div>

                    <div class="mb-5">
                        <label for="descripcionRutina" class="form-label">Descripción</label>
                        <textarea class="form-control" id="descripcionRutina" rows="4" placeholder="Escriba la rutina aquí"></textarea>
                    </div>

                    <div class="d-flex gap-3 justify-content-center">
                        <button type="reset" class="btn btn-light">Limpiar Valores</button>
                        <button type="submit" class="btn btn-primary">Agregar Rutina</button>
                    </div>

                </form>
            </div>
        </div>
        <br />
    </div>

