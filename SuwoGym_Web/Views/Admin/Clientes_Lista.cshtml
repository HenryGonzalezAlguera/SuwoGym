@model IEnumerable<ClienteModel>
@{ ViewData["Title"] = "Clientes"; }

<div class="row">
    <div class="col-12">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <div>
                <div class="suwo-admin-eyebrow"><i class="ti ti-users" aria-hidden="true"></i> Administración</div>
<h1>Clientes</h1>

                <p class="mb-0">
                    Listado de miembros inscritos al gimnasio SUWÓ
                </p>
            </div>

        </div>

    </div>
</div>


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-warning"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="col-md-12">

    <div class="card table-responsive p-2">

        @if (Model != null && Model.Any())
        {
            <table class="table mb-0
                text-nowrap
                table-hover">

                <thead class="border-light">
                    <tr>
                        <th>
                            <b>Identificación</b>
                        </th>
                        <th>
                            <b>Nombre completo</b>
                        </th>

                        <th>
                            <b>Correo electrónico</b>
                        </th>

                        <th>
                            <b>Fecha de Registro</b>
                        </th>

                        <th>
                            <b>Estado</b>
                        </th>

                        <th>
                            <b>Acciones</b>
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">

                            <td>
                                @item.Identificacion
                            </td>
                            <td>
                                @item.Apellido @item.Nombre
                            </td>

                            <td>
                                @item.CorreoElectronico
                            </td>
                            <td>
                                @item.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @if (@item.Estado)
                                {
                                    <span class="badge 
                                            bg-success-subtle 
                                            text-success-emphasis"
                                    >Activo</span>
                                }
                                else
                                {
                                    <span class="badge 
                                            bg-danger-subtle 
                                            text-danger-emphasis"
                                    >Inactivo</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Clientes_Ver"
                                   asp-controller="Admin"
                                   asp-route-i="@item.IdUsuario"
                                   class="btn btn-sm btn-light"
                                   title="Ver cliente">
                                    <i class="ti ti-eye"></i>
                                </a>

                                <a asp-action="Clientes_Editar"
                                   asp-controller="Admin"
                                   asp-route-i="@item.IdUsuario"
                                   class="btn btn-sm btn-light"
                                   title="Editar cliente">
                                    <i class="ti ti-edit"></i>
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="text-center p-4">

                <p class="mb-0">
                    No hay clientes registrados.
                </p>

            </div>
        }

    </div>

</div>