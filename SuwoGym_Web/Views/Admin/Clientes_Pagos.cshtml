@model IEnumerable<PagoListaModel>
@{ ViewData["Title"] = "Historial de pagos"; }

<div class="row">
    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Clientes_Ver" 
            asp-controller="Admin" 
            asp-route-i="@ViewBag.IdUsuario"
            class="btn btn-light"><small>
                <i class="ti ti-arrow-left"></i> 
                Volver al cliente</small></a>
        </div> <br />


        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div class="">
                <div class="suwo-admin-eyebrow"><i class="ti ti-receipt" aria-hidden="true"></i> Administración</div>
<h2>Historial de pagos</h2>
            </div>
        </div>

    </div>
</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-warning"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card table-responsive p-2">

    @if (Model != null && Model.Any())
    {
        <table class="table
            table-hover
            text-nowrap
            mb-0">

            <thead>
                <tr>

                    <th class="fw-bold">Pago</th>

                    <th class="fw-bold">Plan</th>

                    <th class="fw-bold">Método</th>

                    <th class="fw-bold">Fecha</th>

                    <th class="fw-bold">Referencia</th>

                    <th class="fw-bold">Total</th>

                    <th class="text-center fw-bold">
                        Acciones
                    </th>

                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr class="align-middle">

                        <td>
                            #@item.IdPago
                        </td>

                        <td>
                            @item.NombrePlan
                        </td>

                        <td>
                            @item.MetodoPago
                        </td>

                        <td>
                            @item.FechaEmision.ToString(
                                "dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(
                                item.NumeroReferencia)
                                ? "Sin referencia"
                                : item.NumeroReferencia)
                        </td>

                        <td>
                            ₡@item.Total.ToString("N2")
                        </td>

                        <td class="text-center">

                            <a asp-action="Pagos_Ver"
                               asp-controller="Admin"
                               asp-route-i="@item.IdPago"
                               class="btn btn-sm btn-light"
                               title="Ver pago">

                                <i class="ti ti-eye"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="text-center p-4">

            <p class="mb-0">
                El cliente no tiene pagos registrados.
            </p>

        </div>
    }

</div>