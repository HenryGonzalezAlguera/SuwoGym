
@model UsuarioModel

<!-- Header -->
<div class="row">
    <div class="col-12">
        
        <!-- Botón atrás -->
        <div>
            <a asp-action="Empleados_Lista" asp-controller="Admin" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />

        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h2>Detalles del Empleado</h2>
            </div>
            <div>
                <a asp-action="Empleados_Editar" asp-controller="Admin" class="btn btn-outline-primary" asp-route-i="@Model.IdUsuario">
                    <i class="ti ti-edit"></i><span> Editar Empleado</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Encabezado nombre-->
<div class="card">
    <div class="card-body p-4">
        <div class="row">
            <!-- Nombre y Rol -->
            <div class="col-lg-8">
                <div class="mt-2">
                    <h3 class="mb-2"><b>@Model.nombre @Model.apellido</b></h3>
                    <p>
                        <span class="badge bg-info-subtle text-info-emphasis">
                            <i class="ti ti-user"></i> @Model.NombreRol
                        </span>
                    </p>
                </div>
            </div>
        </div>               
    </div>
</div>  
<br />

<!-- Row de tarjetas-->
<div class="row">

    <!-- Tarjeta de información detallada -->
    <div class="col-lg-6 mb-3">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="mb-4"><b>
                        <i class="ti ti-user"></i>
                        Personal
                    </b></h5>
                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Identificación</label>
                            <p class="bip">@Model.identificacion</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Fecha de Nacimiento</label>
                            <p class="bip">
                                @(Model.fechaNac.ToString("dd/MM/yyyy") ?? "No registrada")
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Correo Electrónico</label>
                            <p class="bip">@Model.correoElectronico</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Teléfono</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.telefono)
                                           ? "No registrado"
                                           : Model.telefono)
                            </p>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Dirección</label>
                            <p>@(string.IsNullOrWhiteSpace(Model.direccion)
                                           ? "No registrada"
                                           : Model.direccion) </p>
                        </div>
                    </div>
                </div>
               
            </div>
        </div>
    </div>

    <!-- Información Laboral -->
    <div class="col-lg-6 mb-3">
        <div class="card">




            <div class="card-body p-4">

                <!--Título-->
                <h5 class="mb-4">
                    <b>
                        <i class="ti ti-briefcase-2"></i>
                         Laboral
                    </b>
                </h5>
                
                <!--Informacion-->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Rol</label>
                            <p class="bip">@Model.NombreRol</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Estado</label></br>
                            @if (Model.Estado)
                            {
                                <p class=" badge bg-success-subtle text-success-emphasis bip">
                                    <i class="ti ti-circle-filled me-1"></i> Activo
                                </p>
                            }
                            else
                            {
                                <p class="badge bg-danger-subtle text-danger-emphasis bip">
                                    <i class="ti ti-circle-filled me-1"></i> Inactivo
                                </p>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Fecha de Registro</label>
                            <p class="bip">@Model.fechaRegistro.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                    
                </div>
           
        </div>
    </div>
    </div>

</div>






