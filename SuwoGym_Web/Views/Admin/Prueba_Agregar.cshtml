
@model EmpleadoCrear

<!-- Header -->
<div class="row">
    <div class="col-12">
        <!-- Breadcrumb -->
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Horarios_Agregar" asp-controller="Admin" style="color: #007bff;">Empleados</a></li>
                    <li class="breadcrumb-item active" aria-current="page" style="color: #293039;">Agregar Empleado</li>
                </ol>
            </nav>
        </div>
        <br />
        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="color: #293039; font-weight: 600;">Agregar Empleado</h2>
                <p style="color: #6c757d;" class="mb-0">Registrar los datos de un nuevo empleado</p>
            </div>
            <!-- Indicador de estado -->
            <div class="d-none d-md-block">
                <span class="badge" style="background-color: #007bff; color: white; padding: 8px 16px; border-radius: 20px;">
                    <i class="fas fa-user-plus me-1"></i> Nuevo registro
                </span>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-12">
        <div class="card" style="border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); transition: box-shadow 0.3s ease;">
            <div class="card-body p-4 p-lg-5">

                <!-- Formulario -->
                <form id="EmpleadoAgregarForm" asp-action="Empleados_Agregar" asp-controller="Admin" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="nombre" class="form-label" style="color: #293039; font-weight: 500;">Nombre</label>
                            <input asp-for="Nombre" type="text" class="form-control" id="nombre"
                                   style="border-color: #e0e0e0; border-radius: 10px; padding: 12px 16px; transition: all 0.3s ease;"
                                   onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                   onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';" />

                            <span asp-validation-for="Nombre" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="apellido" class="form-label" style="color: #293039; font-weight: 500;">Apellido</label>
                            <input asp-for="Apellido" type="text" class="form-control" id="apellido"
                                   style="border-color: #e0e0e0; border-radius: 10px; padding: 12px 16px; transition: all 0.3s ease;"
                                   onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                   onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';" />
                            <span asp-validation-for="Apellido" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="identificacion" class="form-label" style="color: #293039; font-weight: 500;">Identificación</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background-color: #f8f9fa; border-color: #e0e0e0; border-radius: 10px 0 0 10px;">
                                    <i class="fas fa-id-card" style="color: #007bff;"></i>
                                </span>
                                <input asp-for="Identificacion" type="text" class="form-control" id="identificacion"
                                       style="border-color: #e0e0e0; border-radius: 0 10px 10px 0; padding: 12px 16px; transition: all 0.3s ease;"
                                       onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                       onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';" />
                            </div>
                            <span asp-validation-for="Identificacion" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="fechaNac" class="form-label" style="color: #293039; font-weight: 500;">Fecha de Nacimiento</label>
                            <input asp-for="FechaNac" type="date" class="form-control" id="fechaNac"
                                   style="border-color: #e0e0e0; border-radius: 10px; padding: 12px 16px; transition: all 0.3s ease;"
                                   onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                   onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';" />
                            <span asp-validation-for="FechaNac" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="telefono" class="form-label" style="color: #293039; font-weight: 500;">Teléfono</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background-color: #f8f9fa; border-color: #e0e0e0; border-radius: 10px 0 0 10px;">
                                    <i class="fas fa-phone" style="color: #007bff;"></i>
                                </span>
                                <input asp-for="Telefono" type="text" class="form-control" id="telefono"
                                       style="border-color: #e0e0e0; border-radius: 0 10px 10px 0; padding: 12px 16px; transition: all 0.3s ease;"
                                       onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                       onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';" />
                            </div>
                            <span asp-validation-for="Telefono" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="correo" class="form-label" style="color: #293039; font-weight: 500;">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background-color: #f8f9fa; border-color: #e0e0e0; border-radius: 10px 0 0 10px;">
                                    <i class="fas fa-envelope" style="color: #007bff;"></i>
                                </span>
                                <input asp-for="CorreoElectronico" type="email" class="form-control" id="correo"
                                       style="border-color: #e0e0e0; border-radius: 0 10px 10px 0; padding: 12px 16px; transition: all 0.3s ease;"
                                       onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                       onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';" />
                            </div>
                            <span asp-validation-for="CorreoElectronico" class="text-danger" style="font-size: 0.875rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="rol" class="form-label" style="color: #293039; font-weight: 500;">Rol</label>
                        <select asp-for="Rol" class="form-select" id="rol"
                                style="border-color: #e0e0e0; border-radius: 10px; padding: 12px 16px; transition: all 0.3s ease;"
                                onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';">
                            <option value="">-- Seleccionar Rol --</option>
                            <option value="1">Administrador</option>
                            <option value="2">Entrenador</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger" style="font-size: 0.875rem;"></span>
                    </div>

                    <div class="mb-5">
                        <label for="direccion" class="form-label" style="color: #293039; font-weight: 500;">Dirección de Vivienda</label>
                        <textarea asp-for="Direccion" class="form-control" id="direccion" rows="4"
                                  style="border-color: #e0e0e0; border-radius: 10px; padding: 12px 16px; transition: all 0.3s ease; resize: vertical;"
                                  onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                                  onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';"></textarea>
                        <span asp-validation-for="Direccion" class="text-danger" style="font-size: 0.875rem;"></span>
                    </div>

                    <!-- Barra de progreso interactiva -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small style="color: #293039; font-weight: 500;">Completitud del formulario</small>
                            <small id="progressText" style="color: #007bff; font-weight: 600;">0%</small>
                        </div>
                        <div class="progress" style="height: 6px; border-radius: 10px; background-color: #e9ecef;">
                            <div id="progressBar" class="progress-bar" role="progressbar"
                                 style="width: 0%; background-color: #007bff; border-radius: 10px; transition: width 0.4s ease;">
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 justify-content-center" style="margin-top: 2rem;">
                        <a asp-action="Empleados_Lista" asp-controller="Admin" class="btn"
                           style="background-color: #f8f9fa; color: #293039; border: 2px solid #e0e0e0; border-radius: 10px; padding: 10px 32px; font-weight: 500; transition: all 0.3s ease;"
                           onmouseover="this.style.backgroundColor='#e9ecef'; this.style.borderColor='#007bff';"
                           onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e0e0e0';">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn"
                                style="background-color: #007bff; color: white; border: none; border-radius: 10px; padding: 10px 32px; font-weight: 500; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(0,123,255,0.3);"
                                onmouseover="this.style.backgroundColor='#0069d9'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(0,123,255,0.4)';"
                                onmouseout="this.style.backgroundColor='#007bff'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(0,123,255,0.3)';">
                            <i class="fas fa-save me-2"></i>Agregar Empleado
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<!-- Font Awesome para los iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Script para la barra de progreso interactiva -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('EmpleadoAgregarForm');
        const inputs = form.querySelectorAll('input, select, textarea');
        const progressBar = document.getElementById('progressBar');
        const progressText = document.getElementById('progressText');

        function updateProgress() {
            let filled = 0;
            const total = inputs.length;

            inputs.forEach(input => {
                if (input.type === 'select-one') {
                    if (input.value && input.value !== '') filled++;
                } else if (input.type === 'textarea') {
                    if (input.value.trim() !== '') filled++;
                } else {
                    if (input.value.trim() !== '') filled++;
                }
            });

            const percentage = Math.round((filled / total) * 100);
            progressBar.style.width = percentage + '%';
            progressText.textContent = percentage + '%';

            // Cambiar color según el porcentaje
            if (percentage < 30) {
                progressBar.style.backgroundColor = '#ff5500';
            } else if (percentage < 70) {
                progressBar.style.backgroundColor = '#007bff';
            } else {
                progressBar.style.backgroundColor = '#293039';
            }
        }

        inputs.forEach(input => {
            input.addEventListener('input', updateProgress);
            input.addEventListener('change', updateProgress);
        });

        // Inicializar
        updateProgress();
    });
</script>

<script src="~/js/empleadoAgregar.js"></script>

