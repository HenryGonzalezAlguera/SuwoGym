@model IEnumerable<UsuarioModel>
<link href="~/css/ejemplo.css" rel="stylesheet" />

<!-- Header -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 style="color: #293039; font-weight: 700;">Empleados (Horarios) </h1>
                <p style="color: #6c757d;" class="mb-0">
                    <i class="fas fa-users me-2" style="color: #007bff;"></i>
                    Listado del personal de Gimnasio SUWÓ
                </p>
            </div>
            <div>
                <a asp-action="Horarios_Agregar" asp-controller="Admin" class="btn"
                   style="background: linear-gradient(135deg, #007bff 0%, #0069d9 100%); color: white; border: none; border-radius: 10px; padding: 12px 24px; font-weight: 600; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(0,123,255,0.3);"
                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 25px rgba(0,123,255,0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,123,255,0.3)';">
                    <i class="fas fa-plus me-2"></i> Agregar Empleado
                </a>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12">

    <!-- Buscador y filtros mejorados -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex gap-2 mb-3 flex-wrap justify-content-between align-items-center">
                <div class="d-flex gap-2 flex-wrap align-items-center" style="flex: 1;">
                    <div class="position-relative" style="flex: 1; min-width: 200px;">
                        <i class="fas fa-search position-absolute"
                           style="left: 15px; top: 50%; transform: translateY(-50%); color: #007bff;"></i>
                        <input type="text" id="searchInput" class="form-control" placeholder="Buscar empleado por nombre, identificación o correo..."
                               style="padding-left: 45px; border-color: #e0e0e0; border-radius: 10px; transition: all 0.3s ease;"
                               onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                               onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';">
                    </div>
                    <select id="filterRol" class="form-select"
                            style="border-color: #e0e0e0; border-radius: 10px; transition: all 0.3s ease; max-width: 180px;"
                            onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                            onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';">
                        <option value="">Todos los roles</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Entrenador">Entrenador</option>
                    </select>
                    <select id="filterEstado" class="form-select"
                            style="border-color: #e0e0e0; border-radius: 10px; transition: all 0.3s ease; max-width: 150px;"
                            onfocus="this.style.borderColor='#007bff'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.15)';"
                            onblur="this.style.borderColor='#e0e0e0'; this.style.boxShadow='none';">
                        <option value="">Todos los estados</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                    <button id="resetFilters" class="btn"
                            style="background-color: #f8f9fa; color: #293039; border: 2px solid #e0e0e0; border-radius: 10px; padding: 8px 20px; transition: all 0.3s ease;"
                            onmouseover="this.style.backgroundColor='#e9ecef'; this.style.borderColor='#007bff';"
                            onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#e0e0e0';">
                        <i class="fas fa-undo me-1"></i> Limpiar
                    </button>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn" id="exportExcel"
                            style="background-color: #ffffff; color: #293039; border: 2px solid #e0e0e0; border-radius: 10px; padding: 8px 20px; transition: all 0.3s ease;"
                            onmouseover="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#ff5500';"
                            onmouseout="this.style.backgroundColor='#ffffff'; this.style.borderColor='#e0e0e0';">
                        <i class="fas fa-file-excel me-1" style="color: #ff5500;"></i> Excel
                    </button>
                    <button class="btn" id="exportPdf"
                            style="background-color: #ffffff; color: #293039; border: 2px solid #e0e0e0; border-radius: 10px; padding: 8px 20px; transition: all 0.3s ease;"
                            onmouseover="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#ff5500';"
                            onmouseout="this.style.backgroundColor='#ffffff'; this.style.borderColor='#e0e0e0';">
                        <i class="fas fa-file-pdf me-1" style="color: #ff5500;"></i> PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Contador de resultados -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span style="color: #293039; font-weight: 500;" id="resultCount">
            <i class="fas fa-list-ul me-2" style="color: #007bff;"></i>
            Mostrando <span id="visibleCount">0</span> empleados
        </span>
        <span style="color: #6c757d; font-size: 0.9rem;">
            <i class="fas fa-sync-alt me-1" style="color: #007bff;"></i>
            Última actualización: <span id="updateTime">hace un momento</span>
        </span>
    </div>

    <!-- Lista de empleados -->
    <div class="card" style="border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div class="table-responsive p-0">
            <table class="table mb-0 text-nowrap" id="empleadosTable" style="margin: 0;">
                <thead style="background: linear-gradient(135deg, #293039 0%, #1a1f27 100%); color: white; border: none;">
                    <tr>
                        <th style="padding: 16px 20px; font-weight: 600; border: none;">
                            <i class="fas fa-id-card me-2"></i>Identificación
                        </th>
                        <th style="padding: 16px 20px; font-weight: 600; border: none;">
                            <i class="fas fa-user me-2"></i>Nombre Completo
                        </th>
                        <th style="padding: 16px 20px; font-weight: 600; border: none;">
                            <i class="fas fa-envelope me-2"></i>Correo Electrónico
                        </th>
                        <th style="padding: 16px 20px; font-weight: 600; border: none;">
                            <i class="fas fa-user-tag me-2"></i>Rol
                        </th>
                        <th style="padding: 16px 20px; font-weight: 600; border: none;">
                            <i class="fas fa-circle me-2"></i>Estado
                        </th>
                        <th style="padding: 16px 20px; font-weight: 600; border: none; text-align: center;">
                            <i class="fas fa-cog me-2"></i>Acciones
                        </th>
                    </tr>
                </thead>
                <tbody id="empleadosBody">
                    @foreach (var item in Model)
                    {
                        <tr class="empleado-row align-middle"
                            style="transition: all 0.3s ease; border-bottom: 1px solid #f0f0f0;"
                            onmouseover="this.style.backgroundColor='#f8f9fa'; this.style.transform='scale(1.002)';"
                            onmouseout="this.style.backgroundColor='transparent'; this.style.transform='scale(1)';"
                            data-identificacion="@item.identificacion"
                            data-nombre="@item.nombre"
                            data-apellido="@item.apellido"
                            data-correo="@item.correoElectronico"
                            data-rol="@item.NombreRol"
                            data-estado="@item.Estado.ToString().ToLower()">
                            <td style="padding: 14px 20px; font-weight: 500; color: #293039;">
                                <span class="badge" style="background-color: #f0f4ff; color: #007bff; padding: 6px 12px; border-radius: 8px; font-weight: 600;">
                                    @item.identificacion
                                </span>
                            </td>
                            <td style="padding: 14px 20px; color: #293039; font-weight: 500;">
                                <i class="fas fa-user-circle me-2" style="color: #007bff;"></i>
                                @item.apellido @item.nombre
                            </td>
                            <td style="padding: 14px 20px; color: #6c757d;">
                                <i class="fas fa-envelope me-2" style="color: #007bff;"></i>
                                @item.correoElectronico
                            </td>
                            <td style="padding: 14px 20px;">
                                <span class="badge" style="background-color: #e8f4fd; color: #007bff; padding: 6px 14px; border-radius: 20px; font-weight: 500;">
                                    @item.NombreRol
                                </span>
                            </td>
                            <td style="padding: 14px 20px;">
                                <div class="d-flex align-items-center gap-2">
                                    @if (@item.Estado)
                                    {
                                        <span class="badge" style="background-color: #e6f7e6; color: #28a745; padding: 6px 14px; border-radius: 20px; font-weight: 500;">
                                            <i class="fas fa-check-circle me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background-color: #f8e8e8; color: #dc3545; padding: 6px 14px; border-radius: 20px; font-weight: 500;">
                                            <i class="fas fa-times-circle me-1"></i> Inactivo
                                        </span>
                                    }
                                    <a href="#" class="btn-toggle-estado" data-id="@item.identificacion"
                                       style="color: #007bff; text-decoration: none; transition: all 0.3s ease;"
                                       onmouseover="this.style.color='#ff5500'; this.style.transform='rotate(180deg)';"
                                       onmouseout="this.style.color='#007bff'; this.style.transform='rotate(0deg)';">
                                        <i class="fas fa-sync-alt"></i>
                                    </a>
                                </div>
                            </td>
                            <td style="padding: 14px 20px; text-align: center;">
                                <a asp-action="Prueba_Detalles" asp-controller="Admin" asp-route-i= "@item.IdUsuario"                                  
                                    style="color: #007bff; text-decoration: none; transition: all 0.3s ease; display: inline-block;"
                                   onmouseover="this.style.color='#ff5500'; this.style.transform='scale(1.2)';"
                                   onmouseout="this.style.color='#007bff'; this.style.transform='scale(1)';">
                                    <i class="fas fa-eye" style="font-size: 1.2rem;"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer de la tabla con paginación -->
        <div class="d-flex justify-content-between align-items-center p-3"
             style="background-color: #f8f9fa; border-top: 1px solid #e0e0e0;">
            <div style="color: #6c757d; font-size: 0.9rem;">
                <i class="fas fa-info-circle me-1" style="color: #007bff;"></i>
                <span id="rowInfo">Mostrando 0 de 0 empleados</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm" id="prevPage"
                        style="background-color: white; color: #293039; border: 1px solid #e0e0e0; border-radius: 8px; padding: 6px 16px; transition: all 0.3s ease;"
                        onmouseover="this.style.backgroundColor='#f0f4ff'; this.style.borderColor='#007bff';"
                        onmouseout="this.style.backgroundColor='white'; this.style.borderColor='#e0e0e0';">
                    <i class="fas fa-chevron-left me-1"></i> Anterior
                </button>
                <span id="pageInfo" class="d-flex align-items-center px-3" style="color: #293039; font-weight: 500;">
                    Página 1
                </span>
                <button class="btn btn-sm" id="nextPage"
                        style="background-color: white; color: #293039; border: 1px solid #e0e0e0; border-radius: 8px; padding: 6px 16px; transition: all 0.3s ease;"
                        onmouseover="this.style.backgroundColor='#f0f4ff'; this.style.borderColor='#007bff';"
                        onmouseout="this.style.backgroundColor='white'; this.style.borderColor='#e0e0e0';">
                    Siguiente <i class="fas fa-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome para los iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Script para interactividad -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const filterRol = document.getElementById('filterRol');
        const filterEstado = document.getElementById('filterEstado');
        const resetFilters = document.getElementById('resetFilters');
        const rows = document.querySelectorAll('.empleado-row');
        const visibleCount = document.getElementById('visibleCount');
        const rowInfo = document.getElementById('rowInfo');
        const updateTime = document.getElementById('updateTime');

        // Actualizar contador y timestamp
        function updateCounters() {
            const visible = Array.from(rows).filter(row => row.style.display !== 'none');
            visibleCount.textContent = visible.length;
            rowInfo.textContent = `Mostrando ${visible.length} de ${rows.length} empleados`;

            // Actualizar timestamp
            const now = new Date();
            updateTime.textContent = now.toLocaleTimeString();
        }

        // Función de filtrado
        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const rolFilter = filterRol.value.toLowerCase();
            const estadoFilter = filterEstado.value;

            rows.forEach(row => {
                const identificacion = row.dataset.identificacion.toLowerCase();
                const nombre = row.dataset.nombre.toLowerCase();
                const apellido = row.dataset.apellido.toLowerCase();
                const correo = row.dataset.correo.toLowerCase();
                const rol = row.dataset.rol.toLowerCase();
                const estado = row.dataset.estado;

                // Búsqueda
                const matchSearch = searchTerm === '' ||
                    identificacion.includes(searchTerm) ||
                    nombre.includes(searchTerm) ||
                    apellido.includes(searchTerm) ||
                    correo.includes(searchTerm);

                // Filtro de rol
                const matchRol = rolFilter === '' || rol === rolFilter;

                // Filtro de estado
                const matchEstado = estadoFilter === '' || estado === estadoFilter;

                // Mostrar u ocultar
                if (matchSearch && matchRol && matchEstado) {
                    row.style.display = '';
                    // Animación de aparición
                    row.style.animation = 'fadeIn 0.3s ease';
                } else {
                    row.style.display = 'none';
                }
            });

            updateCounters();

            // Resetear página a 1 cuando se filtra
            currentPage = 1;
            updatePagination();
        }

        // Event listeners
        searchInput.addEventListener('input', filterTable);
        filterRol.addEventListener('change', filterTable);
        filterEstado.addEventListener('change', filterTable);

        // Resetear filtros
        resetFilters.addEventListener('click', function() {
            searchInput.value = '';
            filterRol.value = '';
            filterEstado.value = '';
            filterTable();
        });

        // Paginación (simulada)
        let currentPage = 1;
        const itemsPerPage = 5;

        function updatePagination() {
            const visible = Array.from(rows).filter(row => row.style.display !== 'none');
            const totalPages = Math.ceil(visible.length / itemsPerPage) || 1;

            if (currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;

            visible.forEach((row, index) => {
                if (index >= start && index < end) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('pageInfo').textContent = `Página ${currentPage} de ${totalPages}`;
            document.getElementById('prevPage').disabled = currentPage === 1;
            document.getElementById('nextPage').disabled = currentPage === totalPages;
        }

        document.getElementById('prevPage').addEventListener('click', function() {
            if (currentPage > 1) {
                currentPage--;
                updatePagination();
            }
        });

        document.getElementById('nextPage').addEventListener('click', function() {
            const visible = Array.from(rows).filter(row => row.style.display !== 'none');
            const totalPages = Math.ceil(visible.length / itemsPerPage);
            if (currentPage < totalPages) {
                currentPage++;
                updatePagination();
            }
        });

        // Inicializar
        filterTable();
        updatePagination();

        // Toggle de estado (simulado)
        document.querySelectorAll('.btn-toggle-estado').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const badge = this.closest('td').querySelector('.badge');
                const isActive = badge.textContent.includes('Activo');

                // Animación de cambio
                badge.style.transition = 'all 0.3s ease';
                badge.style.transform = 'scale(0.8)';

                setTimeout(() => {
                    if (isActive) {
                        badge.innerHTML = '<i class="fas fa-times-circle me-1"></i> Inactivo';
                        badge.style.backgroundColor = '#f8e8e8';
                        badge.style.color = '#dc3545';
                        this.dataset.estado = 'false';
                    } else {
                        badge.innerHTML = '<i class="fas fa-check-circle me-1"></i> Activo';
                        badge.style.backgroundColor = '#e6f7e6';
                        badge.style.color = '#28a745';
                        this.dataset.estado = 'true';
                    }
                    badge.style.transform = 'scale(1)';
                }, 200);
            });
        });

        // Exportar (simulado)
        document.getElementById('exportExcel').addEventListener('click', function() {
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Exportando...';
            setTimeout(() => {
                this.innerHTML = '<i class="fas fa-file-excel me-1" style="color: #ff5500;"></i> Excel';
                alert('✅ Exportación a Excel completada (simulación)');
            }, 1500);
        });

        document.getElementById('exportPdf').addEventListener('click', function() {
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Exportando...';
            setTimeout(() => {
                this.innerHTML = '<i class="fas fa-file-pdf me-1" style="color: #ff5500;"></i> PDF';
                alert('✅ Exportación a PDF completada (simulación)');
            }, 1500);
        });
    });
</script>



