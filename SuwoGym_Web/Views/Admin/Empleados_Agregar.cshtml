<!-- Header -->
<div class="row">
    <div class="col-12">
        <!-- Breadcrumb-->
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Empleados_Lista" asp-controller="Admin">Empleados</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Agregar Empleado</li>
                </ol>
            </nav>
        </div>
        <br />
        <!-- Titulo -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="">
                <h2>Agregar Empleados</h2>
                <p class="mb-0">Registrar los datos de un nuevo empleado</p>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-4">

                <!-- Formulario -->
                <form id="addProductForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="nombre"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="apellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="apellido">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="identificacion" class="form-label">Identificación</label>
                            <input type="text" class="form-control" id="identificacion"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="fechaNac" class="form-label">Fecha de Nacimiento</label>
                            <input type="date" class="form-control" id="fechaNac">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="telefono" class="form-label">Teléfono</label>
                            <input type="text" class="form-control" id="telefono"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="rol" class="form-label">Rol</label>
                            <select class="form-select" id="rol" required="">
                                <option value=""> -- Seleccionar Rol -- </option>
                                <option value="1">Administrador</option>
                                <option value="2">Entrenador</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-5">
                        <label for="direccion" class="form-label">Dirección de Vivienda</label>
                        <textarea class="form-control" id="direccion" rows="4"></textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-light">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Agregar Empleado</button>
                    </div>

                </form>
            </div>
        </div>

    </div>

</div>


