@model RutinaEjercicioAgregarModel

<div class="row">

    <div class="col-12">

        
        <!-- Botón atrás -->
        <div>
            <a asp-action="Rutinas_Lista"
               asp-controller="Entrenador" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />

        <div class="mb-4">

            <h2 class="mb-1">
                Agregar ejercicio
            </h2>

            <p class="mb-0 text-secondary">

                Rutina:
                <strong>
                    @ViewBag.NombreRutina
                </strong>

                · Cliente:
                <strong>
                    @ViewBag.NombreCliente
                </strong>

            </p>

        </div>

    </div>

</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <form asp-action="Rutinas_EjercicioAgregar"
              asp-controller="Entrenador"
              method="post">

            <input asp-for="IdRutina"
                   type="hidden" />

            <div class="row">

                <div class="col-md-8 mb-3">

                    <label asp-for="IdEjercicio"
                           class="form-label">

                        Ejercicio

                    </label>

                    <select asp-for="IdEjercicio"
                            asp-items="ViewBag.Ejercicios"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione un ejercicio
                        </option>

                    </select>

                    <small class="text-secondary">

                        Solo aparecen los ejercicios activos
                        registrados por este entrenador.

                    </small>

                </div>

                <div class="col-md-4 mb-3">

                    <label asp-for="DiaSemana"
                           class="form-label">

                        Día de la semana

                    </label>

                    <select asp-for="DiaSemana"
                            asp-items="ViewBag.Dias"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione un día
                        </option>

                    </select>

                </div>

            </div>

            <div class="row">

                <div class="col-md-3 mb-3">

                    <label asp-for="Series"
                           class="form-label">

                        Series

                    </label>

                    <input asp-for="Series"
                           type="number"
                           class="form-control"
                           min="1"
                           max="100"
                           required />

                </div>

                <div class="col-md-3 mb-3">

                    <label asp-for="Repeticiones"
                           class="form-label">

                        Repeticiones

                    </label>

                    <input asp-for="Repeticiones"
                           type="number"
                           class="form-control"
                           min="1"
                           max="1000"
                           required />

                </div>

                <div class="col-md-3 mb-3">

                    <label asp-for="PesoSugerido"
                           class="form-label">

                        Peso sugerido

                    </label>

                    <div class="input-group">

                        <input asp-for="PesoSugerido"
                               type="number"
                               class="form-control"
                               min="0"
                               step="0.01"
                               placeholder="Opcional" />

                        <span class="input-group-text">
                            kg
                        </span>

                    </div>

                </div>

                <div class="col-md-3 mb-3">

                    <label asp-for="DescansoSegundos"
                           class="form-label">

                        Descanso

                    </label>

                    <div class="input-group">

                        <input asp-for="DescansoSegundos"
                               type="number"
                               class="form-control"
                               min="0"
                               placeholder="Opcional" />

                        <span class="input-group-text">
                            segundos
                        </span>

                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-md-3 mb-3">

                    <label asp-for="Orden"
                           class="form-label">

                        Orden

                    </label>

                    <input asp-for="Orden"
                           type="number"
                           class="form-control"
                           min="1"
                           required />

                    <small class="text-secondary">
                        Posición del ejercicio dentro del día.
                    </small>

                </div>

                <div class="col-md-9 mb-4">

                    <label asp-for="Observacion"
                           class="form-label">

                        Observaciones

                    </label>

                    <textarea asp-for="Observacion"
                              class="form-control"
                              rows="4"
                              maxlength="250"
                              placeholder="Indicaciones técnicas, recomendaciones o precauciones."></textarea>

                </div>

            </div>

            <div class="d-flex
                justify-content-end
                gap-2">

                <a asp-action="Rutinas_Ejercicios"
                   asp-controller="Entrenador"
                   asp-route-i="@Model.IdRutina"
                   class="btn btn-light">

                    Cancelar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="ti ti-device-floppy"></i>

                    Agregar ejercicio

                </button>

            </div>

        </form>

    </div>

</div>