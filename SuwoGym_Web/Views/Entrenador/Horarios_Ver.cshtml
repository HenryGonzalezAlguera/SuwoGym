@model ClaseEntrenadorDetalleModel

<div class="row">

    <div class="col-12">

       
        <!-- Botón atrás -->
        <div>
            <a asp-action="Horarios_Lista"
               asp-controller="Entrenador"
               class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />


        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="mb-1">
                    @Model.NombreClase
                </h2>

                <p class="text-secondary mb-0">
                    Clase programada #@Model.IdClaseProg
                </p>
            </div>

                <a asp-action="Asistencias_Participantes"
                   asp-controller="Entrenador"
                   asp-route-i="@Model.IdClaseProg"
                   class="btn btn-primary">

                    <i class="ti ti-users"></i>
                    Ver participantes

                </a>

           
        </div>

    </div>

</div>


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


<div class="row">

    <!-- Información general-->
    <div class="col-md-8">
        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="mb-4">
                    <h5 class="mb-1 fw-bold">
                        Información de la clase
                    </h5>
                </div>

                <div class="row">

                    <!-- Nombre de clase -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Clase</label>
                            <p class="bip">@Model.NombreClase</p>
                        </div>
                    </div>

                    <!-- Fecha -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Fecha</label>
                            <p class="bip">@Model.FechaHoraInicio.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>

                    <!-- Horario -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Horario</label>
                            <p class="bip">
                                @Model.FechaHoraInicio.ToString("hh:mm tt") - @Model.FechaHoraFin.ToString("hh:mm tt")
                            </p>
                        </div>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Estado Administrativo</label> <br />
                            @if (Model.Estado)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-danger-emphasis">
                                    Inactiva
                                </span>
                            }

                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="col-md-12">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Descripción</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.DescripcionClase)
                                   ? "Sin descripción."
                                   : Model.DescripcionClase)
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- Entrenador asignado -->
    <div class="col-md-4">
        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="mb-4">
                    <h5 class="mb-1 fw-bold">
                        Entrenador asignado
                    </h5>
                </div>

                <div class="row">
                    <!-- Nombre -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Nombre</label>
                            <p class="bip">@Model.NombreEntrenador</p>
                        </div>
                    </div>

                    <!-- Correo -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Correo Electrónico</label>
                            <p class="bip">@Model.CorreoEntrenador</p>
                        </div>
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Teléfono</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.TelefonoEntrenador)
                                                                   ? "No registrado"
                                                                   : Model.TelefonoEntrenador)
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Control de cupos -->
    <div class="col-md-12">
        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="mb-4">

                    <h5 class="mb-1 fw-bold">
                        Control de cupos
                    </h5>

                    <p class="text-secondary mb-0">
                        Capacidad actual de la clase
                    </p>

                </div>


                <div class="row">

                    <!-- Máximo -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Cupo máximo</label>
                            <p class="bip">@Model.CupoMaximo</p>
                        </div>
                    </div>

                    <!-- Actual -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Participantes Registrados</label>
                            <p class="bip">@Model.CupoActual</p>
                        </div>
                    </div>

                    <!-- Disponible -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Cupos Disponibles</label>
                            <p class="bip">@Model.CuposDisponibles</p>
                        </div>
                    </div>

                    <!-- Botón eliminar -->
                    <div class="col-md-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Estado de la clase</label> <br/>
                            @if (Model.EstadoHorario == "Programada")
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">
                                    Programada
                                </span>
                            }
                            else if (Model.EstadoHorario == "En curso")
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                    En curso
                                </span>
                            }
                            else if (Model.EstadoHorario == "Finalizada")
                            {
                                <span class="badge bg-dark-subtle text-danger-emphasis">
                                    Finalizada
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    @Model.EstadoHorario
                                </span>
                            }

                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
