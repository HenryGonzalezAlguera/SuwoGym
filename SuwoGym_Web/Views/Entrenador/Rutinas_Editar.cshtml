@model RutinaEditarModel
@{ ViewData["Title"] = "Modificar rutina"; }

<div class="row suwo-trainer-page">

    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Rutinas_Lista"
               asp-controller="Entrenador" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />


        <div class="mb-4">

            <div class="suwo-trainer-eyebrow"><i class="ti ti-pencil" aria-hidden="true"></i> Área del entrenador</div>
                <h2 class="mb-1">
                Modificar rutina
            </h2>

        </div>

    </div>

</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <form asp-action="Rutinas_Editar"
              asp-controller="Entrenador"
              method="post">

            <input asp-for="IdRutina"
                   type="hidden" />


            <div class="row">

                <div class="col-md-8 mb-3">

                    <label asp-for="NombreRutina"
                           class="form-label">

                        Nombre de la rutina

                    </label>

                    <input asp-for="NombreRutina"
                           class="form-control"
                           maxlength="100"
                           required />

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="Nivel"
                           class="form-label">

                        Nivel

                    </label>

                    <select asp-for="Nivel"
                            asp-items="ViewBag.Niveles"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione un nivel
                        </option>

                    </select>

                </div>

            </div>


            <div class="mb-4">

                <label asp-for="Detalles"
                       class="form-label">

                    Detalles de la rutina

                </label>

                <textarea asp-for="Detalles"
                          class="form-control"
                          rows="8"
                          required></textarea>

            </div>


            <div class="d-flex
                justify-content-end
                gap-2">

                <a asp-action="Rutinas_Ver"
                   asp-controller="Entrenador"
                   asp-route-i="@Model.IdRutina"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>