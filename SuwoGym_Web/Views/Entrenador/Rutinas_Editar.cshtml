@model RutinaEditarModel

<div class="row">

    <div class="col-12">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a asp-action="Rutinas_Lista"
                       asp-controller="Entrenador">

                        Rutinas

                    </a>

                </li>

                <li class="breadcrumb-item">

                    <a asp-action="Rutinas_Ver"
                       asp-controller="Entrenador"
                       asp-route-i="@Model.IdRutina">

                        Detalle

                    </a>

                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">

                    Modificar

                </li>

            </ol>

        </nav>


        <div class="mb-4">

            <h2 class="mb-1">
                Modificar rutina
            </h2>

            <p class="mb-0 text-secondary">
                Actualice la información general de la rutina
            </p>

        </div>

    </div>

</div>


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        <form asp-action="Rutinas_Editar"
              asp-controller="Entrenador"
              method="post">

            <input asp-for="IdRutina"
                   type="hidden" />


            <div class="row">

                <div class="col-md-8 mb-3">

                    <label asp-for="NombreRutina"
                           class="form-label">

                        Nombre de la rutina

                    </label>

                    <input asp-for="NombreRutina"
                           class="form-control"
                           maxlength="100"
                           required />

                </div>


                <div class="col-md-4 mb-3">

                    <label asp-for="Nivel"
                           class="form-label">

                        Nivel

                    </label>

                    <select asp-for="Nivel"
                            asp-items="ViewBag.Niveles"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione un nivel
                        </option>

                    </select>

                </div>

            </div>


            <div class="mb-4">

                <label asp-for="Detalles"
                       class="form-label">

                    Detalles de la rutina

                </label>

                <textarea asp-for="Detalles"
                          class="form-control"
                          rows="8"
                          required></textarea>

            </div>


            <div class="d-flex
                justify-content-end
                gap-2">

                <a asp-action="Rutinas_Ver"
                   asp-controller="Entrenador"
                   asp-route-i="@Model.IdRutina"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="ti ti-device-floppy"></i>

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>