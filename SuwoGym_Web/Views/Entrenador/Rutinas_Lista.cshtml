@model List<RutinaListaModel>
@{ ViewData["Title"] = "Rutinas de clientes"; }

<div class="row suwo-trainer-page">

    <div class="col-12">

        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <div class="suwo-trainer-eyebrow"><i class="ti ti-activity" aria-hidden="true"></i> Área del entrenador</div>
                <h2 class="mb-1">
                    Rutinas
                </h2>

                <p class="mb-0 text-secondary">
                    Gestión de las rutinas asignadas a sus clientes
                </p>

            </div>


            <a asp-action="Rutinas_Agregar"
               asp-controller="Entrenador"
               class="btn btn-primary">

                <i class="ti ti-plus"></i>

                Nueva rutina

            </a>

        </div>

    </div>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-info"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table
                    table-hover
                    align-middle">

                    <thead>

                        <tr>

                            <th>
                                Rutina
                            </th>

                            <th>
                                Cliente
                            </th>

                            <th>
                                Nivel
                            </th>

                            <th>
                                Fecha de creación
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @item.NombreRutina
                                    </strong>

                                </td>


                                <td>

                                    <div>

                                        <strong>
                                            @item.NombreCliente
                                        </strong>

                                    </div>

                                    <small class="text-secondary">
                                        @item.CorreoElectronico
                                    </small>

                                </td>


                                <td>

                                    @if (item.Nivel == "Principiante")
                                    {
                                        <span class="badge bg-info">
                                            Principiante
                                        </span>
                                    }
                                    else if (item.Nivel == "Intermedio")
                                    {
                                        <span class="badge bg-warning">
                                            Intermedio
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Avanzado
                                        </span>
                                    }

                                </td>


                                <td>

                                    @(item.FechaCreacion.ToString("dd/MM/yyyy"))

                                </td>


                                <td>

                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactiva
                                        </span>
                                    }

                                </td>


                                <td class="text-center">

                                    <a asp-action="Rutinas_Ver"
                                       asp-controller="Entrenador"
                                       asp-route-i="@item.IdRutina"
                                       class="btn btn-sm btn-light"
                                       title="Ver rutina">

                                        <i class="ti ti-eye"></i>

                                    </a>


                                    <a asp-action="Rutinas_Editar"
                                       asp-controller="Entrenador"
                                       asp-route-i="@item.IdRutina"
                                       class="btn btn-sm btn-light"
                                       title="Modificar rutina">

                                        <i class="ti ti-pencil"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5 suwo-trainer-empty">

                <i class="ti ti-activity"
                   style="font-size: 48px;">
                </i>

                <h4 class="mt-3">
                    No hay rutinas registradas
                </h4>

                <p class="text-secondary">
                    Registre una rutina para uno de sus clientes asignados.
                </p>

                <a asp-action="Rutinas_Agregar"
                   asp-controller="Entrenador"
                   class="btn btn-primary">

                    <i class="ti ti-plus"></i>

                    Registrar rutina

                </a>

            </div>
        }

    </div>

</div>