@model RutinaEjercicioDetalleModel
@{ ViewData["Title"] = "Detalle del ejercicio"; }

<div class="row suwo-trainer-page">

    <div class="col-12">


        <!-- Botón atrás -->
        <div>
            <a asp-action="Rutinas_Ejercicios"
               asp-controller="Entrenador"
               asp-route-i="@Model.IdRutina"
               class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />


        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <div class="suwo-trainer-eyebrow"><i class="ti ti-barbell" aria-hidden="true"></i> Área del entrenador</div>
                <h2 class="mb-1">
                    @Model.NombreEjercicio
                </h2>

                <p class="mb-0 text-secondary">
                    Detalle del ejercicio asignado a la rutina
                </p>

            </div>


            @if (Model.Estado)
            {
                <a asp-action="Rutinas_EjercicioEditar"
                   asp-controller="Entrenador"
                   asp-route-i="@Model.IdRutinaEjercicio"
                   class="btn btn-primary">

                    <i class="ti ti-pencil"></i>

                    Modificar

                </a>
            }

        </div>

    </div>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


<div class="row">
    
    <!-- INFORMACIÓN GENERAL -->
    <div class="col-lg-6 mb-3">    
        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-4">

                    <div>

                        <h5 class="mb-1 fw-bold">
                            Información del ejercicio
                        </h5>

                    </div>

                </div>


                <div class="row">
                    
                    <!--Nombre-->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Ejercicio</label>
                            <p class="bip">@Model.NombreEjercicio</p>
                        </div>
                    </div>

                    <!--Grupo Muscular-->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Grupo Muscular</label>
                            <p class="bip">@Model.GrupoMuscular</p>
                        </div>
                    </div>

                    <!-- Dia semana -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Día de la semana</label>
                            <p class="bip">@Model.DiaSemana</p>
                        </div>
                    </div>

                
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Descripción</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.Descripcion)
                              ? "Sin descripción"
                              : Model.Descripcion)
                            </p>
                        </div>

                    </div>
                    <div class="col-md-12 mb-3 d-flex justify-content-end">
                        <form asp-action="Rutinas_EjercicioQuitar"
                              asp-controller="Entrenador"
                              method="post">

                            <input type="hidden"
                                   name="IdRutinaEjercicio"
                                   value="@Model.IdRutinaEjercicio" />

                            <input type="hidden"
                                   name="IdRutina"
                                   value="@Model.IdRutina" />


                            <button type="submit"
                                    class="btn btn-outline-danger"
                                    onclick="return confirm('¿Desea retirar este ejercicio de la rutina?');">

                                <i class="ti ti-trash"></i>

                                Retirar ejercicio

                            </button>

                        </form>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- CONFIGURACIÓN DE LA RUTINA -->
    <div class="col-lg-6 mb-3">
        <div class="card">

            <div class="card-body p-4">

                <div class="mb-4">

                    <h5 class="mb-1 fw-bold">
                        Configuración dentro de la rutina
                    </h5>

                </div>


                <div class="row">

                    <!-- Orden -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Orden dentro del día</label>
                            <p class="bip">@Model.Orden</p>
                        </div>
                    </div>
                    <!-- Series -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Series</label>
                            <p class="bip">@Model.Series</p>
                        </div>
                    </div>
                    <!-- Repeticiones -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Repeticiones</label>
                            <p class="bip">@Model.Repeticiones</p>
                        </div>
                    </div>
                    <!-- Peso -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Peso Sugerido (kg)</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.PesoSugerido.ToString())
                                    ? "No asignado"
                                    : Model.PesoSugerido.ToString())
                            </p>
                        </div>
                    </div>
                    <!-- Descanso -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Descanso (s)</label>
                            <p class="bip">@Model.DescansoSegundos</p>
                        </div>
                    </div>
                    <!-- Fecha Asigna -->
                    <div class="col-md-4 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Fecha de asignación</label>
                            <p class="bip">@Model.FechaAsignacion.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                    <!-- Observaciones -->
                    <div class="col-md-12 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Observaciones del entrenador</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.Observacion)
                                  ? "Sin observaciones"
                                  : Model.Observacion)
                            </p>
                        </div>
                    </div>

                </div>


                
            </div>

        </div>
    </div>

</div>

