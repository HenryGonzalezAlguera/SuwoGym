@model List<ClaseEntrenadorListaModel>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-1">
            Mi cronograma
        </h2>

        <p class="text-secondary mb-0">
            Clases que han sido asignadas a su cuenta
        </p>

    </div>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}


@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-info"
         role="alert">

        @ViewBag.MensajeError

    </div>
}


<div class="card">

    <div class="card-body p-4">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th class="fw-bold">
                                Clase
                            </th>

                            <th class="fw-bold">
                                Fecha
                            </th>

                            <th class="fw-bold">
                                Horario
                            </th>

                            <th class="fw-bold">
                                Participantes
                            </th>

                            <th class="fw-bold">
                                Disponibles
                            </th>

                            <th class="fw-bold">
                                Estado
                            </th>

                            <th class="text-center fw-bold">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @item.NombreClase
                                    </strong>

                                    <div>

                                        <small class="text-secondary">
                                            Clase #@item.IdClaseProg
                                        </small>

                                    </div>

                                </td>


                                <td>

                                    @item.FechaHoraInicio.ToString("dd/MM/yyyy")

                                </td>


                                <td>

                                    @item.FechaHoraInicio.ToString("hh:mm tt")

                                    -

                                    @item.FechaHoraFin.ToString("hh:mm tt")

                                </td>


                                <td>

                                    <strong>
                                        @item.CupoActual / @item.CupoMaximo
                                    </strong>

                                </td>


                                <td>

                                    @if (item.CuposDisponibles > 0)
                                    {
                                        <span class="badge bg-success">

                                            @item.CuposDisponibles cupos

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            Sin cupos

                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (item.EstadoHorario == "Programada")
                                    {
                                        <span class="badge bg-success">
                                            Programada
                                        </span>
                                    }
                                    else if (item.EstadoHorario == "En curso")
                                    {
                                        <span class="badge bg-warning">
                                            En curso
                                        </span>
                                    }
                                    else if (item.EstadoHorario == "Finalizada")
                                    {
                                        <span class="badge bg-dark">
                                            Finalizada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.EstadoHorario
                                        </span>
                                    }

                                </td>


                                <td class="text-center">

                                    <a asp-action="Horarios_Ver"
                                       asp-controller="Entrenador"
                                       asp-route-i="@item.IdClaseProg"
                                       class="btn btn-sm btn-light"
                                       title="Ver detalle">

                                        <i class="ti ti-eye"></i>

                                    </a>
                                    <a asp-action="Asistencias_Participantes"
                                       asp-controller="Entrenador"
                                       asp-route-i="@item.IdClaseProg"
                                       class="btn btn-sm btn-primary"
                                       title="Ver participantes">

                                        <i class="ti ti-users"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="ti ti-calendar-off"
                   style="font-size: 48px;">
                </i>

                <h4 class="mt-3">
                    No tiene clases programadas
                </h4>

                <p class="text-secondary mb-0">

                    Las clases asignadas por el administrador
                    aparecerán en esta sección.

                </p>

            </div>
        }

    </div>

</div>