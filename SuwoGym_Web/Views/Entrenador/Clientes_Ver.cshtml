@model EntrenadorClienteDetalleModel

<div class="row">

    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Clientes_Lista" asp-controller="Entrenador" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />

        <div class="mb-4">
            <h2>
                Detalle del cliente
            </h2>
        </div>

    </div>

</div>


<div class="row">

   <!-- INFORMACIÓN PERSONAL -->
    <div class="col-lg-6 mb-3">
        <div class="card">

            <div class="card-body p-4">

                <!-- Información personal -->
                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-4">

                    <div>
                        <h5>
                            <b>Información personal</b>
                        </h5>
                    </div>
                </div>

                <div class="row g-3 mb-3">

                        <!-- Nombre completo -->
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Nombre Completo</label>
                            <p class="bip">@Model.Nombre @Model.Apellido</p>
                        </div>
                    </div>

                        <!-- Identificacion -->
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Identificación</label>
                            <p class="bip">@Model.Identificacion</p>
                        </div>
                    </div>

                        <!-- Correo -->
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Correo Electrónico</label>
                            <p class="bip">@Model.CorreoElectronico</p>
                        </div>
                    </div>

                        <!-- Telefono -->
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Teléfono</label>
                            <p class="bip">
                                @(string.IsNullOrWhiteSpace(Model.Telefono)
                                                   ? "No registrado"
                                                   : Model.Telefono)
                            </p>
                        </div>
                    </div>

                        <!-- Fecha Nac -->
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Fecha de Nacimiento</label>
                            <p class="bip">
                                @(Model.FechaNac?.ToString("dd/MM/yyyy") ?? "No registrada")
                            </p>
                        </div>
                    </div>

                        <!-- Fecha Asigna -->
                    <div class="col-md-6">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Fecha de Asignación</label>
                            <p class="bip">
                                @(Model.FechaAsignacion.ToString("dd/MM/yyyy") ?? "No registrada")
                            </p>
                        </div>
                    </div>

                        <!-- Dirección -->
                    <div class="col-md-12">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Dirección</label>
                            <p class="bip">
                                @(Model.Direccion ?? "No registrada")
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- MEMBRESÍA -->
    <div class="col-lg-6 mb-3">
        
        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-4">

                    <div>
                        <h5 class="mb-1 fw-bold">
                            Membresía
                        </h5>
                    </div>

                </div>


                @if (Model.IdMembresia.HasValue)
                {
                    <div class="row">

                            <!-- Nombre Plan -->
                        <div class="col-md-6">
                            <div class="bloque_info">
                                <label class="bloque_info_titulo">Plan Seleccionado</label>
                                <p class="bip">@Model.NombrePlan</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- Estado Membresía -->
                            <div class="bloque_info">
                                <label class="bloque_info_titulo">Estado de Membresía</label> <br />
                                @if (string.Equals(
                                    Model.EstadoMembresia,
                                    "Activa",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">
                                        Activa
                                    </span>
                                }
                                else if (string.Equals(
                                    Model.EstadoMembresia,
                                    "Vencida",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis">
                                        Vencida
                                    </span>
                                }
                                else if (string.Equals(
                                    Model.EstadoMembresia,
                                    "Cancelada",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                        Cancelada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                        @Model.EstadoMembresia
                                    </span>
                                }

                            </div>
                        </div>


                            <!-- Fecha Inicio -->
                        <div class="col-md-6">
                            <div class="bloque_info">
                                <label class="bloque_info_titulo">Fecha de Inicio</label>
                                <p class="bip">@(Model.FechaInicio?.ToString("dd/MM/yyyy") ?? "No registrada")</p>
                            </div>
                        </div>

                            <!-- Fecha Vencimiento -->
                        <div class="col-md-6">
                            <div class="bloque_info">
                                <label class="bloque_info_titulo">Fecha de Vencimiento</label>
                                <p class="bip">@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</p>
                            </div>
                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0"
                         role="alert">

                        El cliente no tiene una membresía asignada.

                    </div>
                }


            </div>
        </div>        

        <div class="row mt-3">
        <div class="d-flex
             justify-content-end
             align-items-center
             mb-4">
            <a asp-action="Rutinas_Agregar"
               asp-controller="Entrenador"
               class="btn btn-primary">

                <i class="ti ti-plus"></i>

                Asignar una rutina

            </a>
        </div>
        </div>
    </div>



</div>
