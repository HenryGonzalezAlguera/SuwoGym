@model EntrenadorClienteDetalleModel

<div class="row">

    <div class="col-12">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a asp-action="Clientes_Lista"
                       asp-controller="Entrenador">

                        Clientes asignados

                    </a>

                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">

                    Detalle del cliente

                </li>

            </ol>

        </nav>


        <div class="mb-4">

            <h2>
                Detalle del cliente
            </h2>

            <p class="mb-0">
                Información del cliente bajo su seguimiento
            </p>

        </div>

    </div>

</div>


<!-- INFORMACIÓN PERSONAL -->

<div class="card">

    <div class="card-body p-4">

        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <h4 class="mb-1">
                    Información personal
                </h4>

                <p class="mb-0 text-secondary">
                    Datos registrados del cliente
                </p>

            </div>


            @if (Model.Estado)
            {
                <span class="badge bg-success">
                    Activo
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Inactivo
                </span>
            }

        </div>


        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Identificación
                </label>

                <input type="text"
                       class="form-control"
                       value="@(string.IsNullOrWhiteSpace(Model.Identificacion)
                                           ? "No registrada"
                                           : Model.Identificacion)"
                       readonly />

            </div>


            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Nombre completo
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.Nombre @Model.Apellido"
                       readonly />

            </div>

        </div>


        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Correo electrónico
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.CorreoElectronico"
                       readonly />

            </div>


            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Teléfono
                </label>

                <input type="text"
                       class="form-control"
                       value="@(string.IsNullOrWhiteSpace(Model.Telefono)
                                           ? "No registrado"
                                           : Model.Telefono)"
                       readonly />

            </div>

        </div>


        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Fecha de nacimiento
                </label>

                <input type="text"
                       class="form-control"
                       value="@(Model.FechaNac.HasValue
                                           ? Model.FechaNac.Value.ToString("dd/MM/yyyy")
                                       : "No registrada")"
                       readonly />

            </div>


            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Fecha de asignación
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.FechaAsignacion.ToString("dd/MM/yyyy")"
                       readonly />

            </div>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Dirección
            </label>

            <textarea class="form-control"
                      rows="3"
                      readonly>@(string.IsNullOrWhiteSpace(Model.Direccion)
                          ? "No registrada"
                          : Model.Direccion)</textarea>

        </div>

    </div>

</div>


<!-- MEMBRESÍA -->

<div class="card mt-4">

    <div class="card-body p-4">

        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>

                <h4 class="mb-1">
                    Membresía
                </h4>

                <p class="mb-0 text-secondary">
                    Estado del plan actual del cliente
                </p>

            </div>


            @if (string.Equals(
                Model.EstadoMembresia,
                "Activa",
                StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge bg-success">
                    Activa
                </span>
            }
            else if (string.Equals(
                Model.EstadoMembresia,
                "Vencida",
                StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge bg-danger">
                    Vencida
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(
                Model.EstadoMembresia))
            {
                <span class="badge bg-secondary">
                    @Model.EstadoMembresia
                </span>
            }

        </div>


        @if (Model.IdMembresia.HasValue)
        {
            <div class="row">

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Número de membresía
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.IdMembresia"
                           readonly />

                </div>


                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Plan
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.NombrePlan"
                           readonly />

                </div>


                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Estado
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.EstadoMembresia"
                           readonly />

                </div>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Fecha de inicio
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(Model.FechaInicio.HasValue
                                                   ? Model.FechaInicio.Value.ToString("dd/MM/yyyy")
                                               : "No registrada")"
                           readonly />

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Fecha de vencimiento
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(Model.FechaVencimiento.HasValue
                                                   ? Model.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                               : "No registrada")"
                           readonly />

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0"
                 role="alert">

                El cliente no tiene una membresía asignada.

            </div>
        }

    </div>

</div>


<div class="text-center mt-4">

    <a asp-action="Clientes_Lista"
       asp-controller="Entrenador"
       class="btn btn-light">

        Volver a clientes

    </a>

</div>