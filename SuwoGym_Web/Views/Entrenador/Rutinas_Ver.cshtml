@model RutinaDetalleModel
@{ ViewData["Title"] = "Detalle de rutina"; }

<div class="row suwo-trainer-page">

    <div class="col-12">

        <!-- Botón atrás -->
        <div>
            <a asp-action="Rutinas_Lista" 
            asp-controller="Entrenador" class="btn btn-light"><small><i class="ti ti-arrow-left"></i> Volver</small></a>
        </div> <br />


        <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

            <div>
                <div class="suwo-trainer-eyebrow"><i class="ti ti-activity" aria-hidden="true"></i> Área del entrenador</div>
                <h2 class="mb-1">
                    @Model.NombreRutina
                </h2>
            </div>


            <div class="d-flex gap-2">

                
                <a asp-action="Rutinas_Editar"
                   asp-controller="Entrenador"
                   asp-route-i="@Model.IdRutina"
                   class="btn btn-outline-primary">

                    <i class="ti ti-pencil"></i>

                    Modificar

                </a>

            </div>

        </div>

    </div>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success"
         role="alert">

        @TempData["MensajeExito"]

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger"
         role="alert">

        @TempData["MensajeError"]

    </div>
}



<div class="row">

    <!-- DATOS DE RUTINA -->
    <div class="col-lg-6 mb-3">

        <div class="card">

        <div class="card-body p-4">

            <div class="d-flex
                justify-content-between
                align-items-center
                mb-4">

                <div>
                    <h5 class="mb-1 fw-bold">
                        Información de la rutina
                    </h5>
                </div>

            </div>


            <div class="row">

                <!-- Nivel -->
                <div class="col-md-6 mb-3">
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Nivel de dificultad</label>
                        <p class="bip">@Model.Nivel</p>
                    </div>
                </div>
                <!-- Fecha de Creación -->
                <div class="col-md-6 mb-3">
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Fecha de Creación</label>
                        <p class="bip">@Model.FechaCreacion.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>

                <!-- Nombre de rutina -->
                <div class="col-md-12 mb-3">
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Nombre de rutina</label>
                        <p class="bip">@Model.NombreRutina</p>
                    </div>
                </div>
                <!-- Detalles de rutina -->
                <div class="col-md-12 mb-3">
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Detalles</label>
                        <p class="bip">@Model.Detalles</p>
                    </div>
                </div>
                
                <hr class="lineaGris" />
                
                <!-- Detalles de rutina -->
                <div class="col-md-6 mb-3">
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Listado</label>
                        <p class="bip">Ejercicios</p>
                    </div>
                </div>
                <div class="col-md-6 mb-3 d-flex
                        justify-content-end
                        align-items-center">
                        
                    <a asp-action="Rutinas_Ejercicios"
                        asp-controller="Entrenador"
                        asp-route-i="@Model.IdRutina"
                        class="btn btn-outline-primary">

                        <i class="ti ti-barbell"></i>

                        Ver Ejercicios

                    </a>

                </div>


                <hr class="lineaGris" />
                
                <!-- Estado -->
                <div class="col-md-6 mb-3">
                    <div class="bloque_info">
                        <label class="bloque_info_titulo">Estado</label> <br />
                        @if (Model.Estado)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis">
                                Activa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger-emphasis">
                                Inactiva
                            </span>
                        }
                    </div>
                </div>
                <!-- Botón -->
                <div class="col-md-6 mb-3 d-flex
                        justify-content-end
                        align-items-center">

                        <form asp-action="Rutinas_CambiarEstado"
                              asp-controller="Entrenador"
                              method="post">

                            <input type="hidden"
                                   name="IdRutina"
                                   value="@Model.IdRutina" />

                            <input type="hidden"
                                   name="Estado"
                                   value="@Model.Estado.ToString().ToLower()" />


                            @if (Model.Estado)
                            {
                                <button type="submit"
                                        class="btn btn-outline-danger"
                                        onclick="return confirm('¿Desea desactivar esta rutina?');">

                                    <i class="ti ti-ban"></i>

                                    Desactivar

                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-outline-success"
                                        onclick="return confirm('¿Desea activar esta rutina?');">

                                    <i class="ti ti-check"></i>

                                    Activar

                                </button>
                            }

                        </form>

                </div>

            </div>



        </div>

    </div>

    </div>

    <div class="col-lg-6">
        
    <!-- INFORMACIÓN DEL CLIENTE-->
        <div class="card mb-3">

            <div class="card-body p-4">

                <div class="mb-4">

                    <h5 class="mb-1 fw-bold">
                        Cliente asignado
                    </h5>
                </div>


                <div class="row">

                    <!-- Nombre completo -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Nombre Completo</label>
                            <p class="bip">@Model.NombreCliente</p>
                        </div>
                    </div>

                    <!-- Identificacion -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Identificación</label>
                            <p class="bip">@Model.Identificacion</p>
                        </div>
                    </div>

                    <!-- Correo -->
                    <div class="col-md-6 mb-3">
                        <div class="bloque_info">
                            <label class="bloque_info_titulo">Correo Electrónico</label>
                            <p class="bip">@Model.CorreoElectronico</p>
                        </div>
                    </div>

                    <!-- botón de Ver el cliente-->
                    <div class="col-md-6 mb-3">
                        <a asp-action="Clientes_Ver"
                           asp-controller="Entrenador"
                           asp-route-i="@Model.IdCliente"
                           class="btn btn-light">

                            <i class="ti ti-user"></i>

                            Ver cliente

                        </a>
                    </div>

                </div>


              

            </div>

        </div>


        <div class="card mb-3">

        </div>

    </div>

</div>